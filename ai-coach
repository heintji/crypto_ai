def analyseer_patronen(conn, uur_data: List[Dict], dag_data: List[Dict]) -> Dict:
    """Herkent beste/slechtste uren en dagen."""
    patroon = {
        "beste_uren": [], "slechte_uren": [],
        "beste_dagen": [], "slechte_dagen": [],
        "aanbeveling_start": TRADING_HOURS_START,
        "aanbeveling_end": TRADING_HOURS_END,
    }

    for r in uur_data:
        uur = safe_int(r.get("uur"))
        wr  = safe_float(r.get("win_rate"))
        n   = safe_int(r.get("n"))
        if n < 3:
            continue
        if wr >= 60:
            patroon["beste_uren"].append({"uur": uur, "wr": wr})
        elif wr < 40:
            patroon["slechte_uren"].append({"uur": uur, "wr": wr})

    dag_namen = {0:"Zo",1:"Ma",2:"Di",3:"Wo",4:"Do",5:"Vr",6:"Za"}
    for r in dag_data:
        dag  = safe_int(r.get("dag_nr"))
        wr   = safe_float(r.get("win_rate"))
        n    = safe_int(r.get("n"))
        naam = dag_namen.get(dag, str(dag))
        if n < 3:
            continue
        if wr >= 58:
            patroon["beste_dagen"].append({"dag": naam, "wr": wr})
        elif wr < 42:
            patroon["slechte_dagen"].append({"dag": naam, "wr": wr})

    if patroon["beste_uren"]:
        uren = [u["uur"] for u in patroon["beste_uren"]]
        patroon["aanbeveling_start"] = max(6, min(uren))
        patroon["aanbeveling_end"]   = min(23, max(uren) + 1)

    sla_geheugen_op(conn, "patroon", "beste_uren", patroon["beste_uren"])
    sla_geheugen_op(conn, "patroon", "beste_dagen", patroon["beste_dagen"])
    return patroon


