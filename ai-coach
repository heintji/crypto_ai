    stop_advies:      Dict,
    uur_advies:       Dict,
    coin_analyse:     Dict,
    edge_decay:       Dict,
    pf_trend:         Dict,
    aanpassingen:     List[str],
    dagen:            int,
) -> str:
    """
    Claude geeft een finale holistische beoordeling van alle analyse.
    Dit is het slimste gedeelte — Claude verbindt alle losse analyses
    tot een coherent advies.
    """
    n        = safe_int(totalen.get("n"))
    wr       = safe_float(totalen.get("win_rate"))
    pf       = safe_float(totalen.get("profit_factor"))
    net_pnl  = safe_float(totalen.get("net_pnl"))
    avg_r    = safe_float(totalen.get("avg_r"))

    live_wr  = safe_float(edge_decay.get("LIVE_wr"))
    sim_wr   = safe_float(edge_decay.get("SIM_wr"))
    ed_diff  = sim_wr - live_wr

    setup_samenvatting = "\n".join(
        f"- {safe_str(r.get('setup'))}: {safe_float(r.get('win_rate')):.1f}% WR ({safe_int(r.get('n'))} trades)"
        for r in setup_data[:6]
    ) if setup_data else "geen data"

    aanpassing_tekst = "\n".join(f"- {a}" for a in aanpassingen) if aanpassingen else "geen"

    prompt = f"""
Je bent een senior crypto trading bot coach met expertise in systematisch traden.
Analyseer alle beschikbare data en geef een concrete, actiegericht advies.
Spreek in het Nederlands. Wees direct en specifiek.

PERIODE: Laatste {dagen} dagen
TOTALE STATISTIEKEN:
- Trades: {n}
- Win rate: {wr:.1f}%
- Netto PnL: €{net_pnl:.4f}
- Profit Factor: {pf:.2f}
- Gem. R per trade: {avg_r:.3f}

SETUP PERFORMANCE:
{setup_samenvatting}

PARAMETER AANBEVELINGEN (algoritmisch bepaald):
{aanpassing_tekst}

EDGE DECAY:
- Simulatie WR: {sim_wr:.1f}%
- Live WR: {live_wr:.1f}%
- Verschil: {ed_diff:.1f}% {'⚠️ PROBLEEM' if ed_diff > EDGE_DECAY_DREMPEL else '✅ OK'}

PROFIT FACTOR TREND: {pf_trend.get('trend','onbekend')}
(eerste helft: {pf_trend.get('eerste_helft',0):.2f} → tweede helft: {pf_trend.get('tweede_helft',0):.2f})

STOP LOSS ANALYSE:
- Gem. MAE: {stop_advies.get('gem_mae',0):.2f}R
- ATR multiplier advies: {stop_advies.get('actie','OK')} ({stop_advies.get('huidig',2.0):.1f} → {stop_advies.get('aanbeveling',2.0):.1f})

Geef een finale beoordeling in 5-7 zinnen:
1. Is dit systeem gezond of zijn er structurele problemen?
2. Wat is de MEEST URGENTE aanpassing?
3. Welke setups moet de gebruiker prioritiseren?
4. Is edge decay een risico of niet?
5. Wat is het doel voor de komende 2 weken?
6. Geef één specifiek getal: wat moet de score drempel worden?
""".strip()

    return _claude_analyse(prompt, max_tokens=600)


