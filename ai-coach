def run_health_check(conn) -> None:
    """Licht health check — stuurt alleen WhatsApp bij problemen."""
    log("Health check...")

    # Drawdown
    check_drawdown_bescherming(conn)

    # Consecutive losses
    try:
        rows = run_query(conn, """
        SELECT outcome FROM public.experience_trades
        WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
          AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
        ORDER BY COALESCE(exit_time,updated_at) DESC LIMIT 5
        """)
        cons = 0
        for row in rows:
            if safe_str(row.get("outcome")).upper() == "LOSS":
                cons += 1
            else:
                break
        if cons >= 4:
            stuur_alert(f"{cons}x VERLIES OP RIJ",
                        f"{cons} verliezen achter elkaar",
                        "Stuur ANALYSE voor volledige analyse")
    except Exception:
        pass

    # Edge decay
    edge = get_edge_decay(conn, 30)
    lwr = safe_float(edge.get("LIVE_wr"))
    swr = safe_float(edge.get("SIM_wr"))
    if swr > 0 and lwr > 0 and (swr - lwr) > EDGE_DECAY_DREMPEL:
        stuur_alert("EDGE DECAY",
                    f"Sim {swr:.1f}% vs Live {lwr:.1f}% (>{EDGE_DECAY_DREMPEL:.0f}%)",
                    "Stuur ANALYSE voor details")

    log("Health check klaar")


