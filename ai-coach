def pas_parameters_aan(conn, aanpassingen: List[Dict]) -> List[str]:
    """
    Past parameters automatisch aan in bot_state.
    Bot leest deze bij volgende scan.
    """
    toegepast = []
    for a in aanpassingen:
        key   = safe_str(a.get("key"))
        value = safe_str(a.get("value"))
        reden = safe_str(a.get("reden"))
        if not key or not value:
            continue

        # Veiligheidscontroles
        if key == "min_score_to_trade" and not (80 <= safe_int(value) <= 99):
            log(f"⚠️ {key}={value} buiten veilig bereik — skip")
            continue
        if key == "atr_multiplier" and not (1.0 <= safe_float(value) <= 4.0):
            log(f"⚠️ {key}={value} buiten veilig bereik — skip")
            continue
        if key == "max_per_trade_eur" and not (0.10 <= safe_float(value) <= 5.0):
            log(f"⚠️ {key}={value} buiten veilig bereik — skip")
            continue

        oude = get_bot_state(conn, key, "?")
        set_bot_state(conn, key, value)
        log(f"🔧 {key}: {oude} → {value} ({reden})")
        toegepast.append(f"{key}: {oude} → {value}")

    return toegepast


