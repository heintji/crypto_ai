def get_stop_loss_analyse(conn, days: int = 60) -> Dict[str, float]:
    """
    Analyseert de effectiviteit van de stop loss via MAE.

    MAE = Maximum Adverse Excursion = hoeveel de prijs bewoog
    tegen de positie in voordat die keerde of de stop raakte.

    Als gem. MAE hoog is maar de trade toch wint → stop is prima.
    Als gem. MAE hoog is en de trade verliest → stop is te krap.
    Als gem. MAE laag is maar veel trades raken stop → stop is OK maar signalen zijn slecht.
    """
    rows = run_query(conn, """
    SELECT
        ROUND(AVG(COALESCE(mae, mae_r, 0))::numeric, 3) AS gem_mae,
        ROUND(AVG(COALESCE(mfe, mfe_r, 0))::numeric, 3) AS gem_mfe,
        ROUND(AVG(COALESCE(pnl_r, result_r, 0))::numeric, 3) AS gem_r,
        COUNT(*) FILTER (WHERE UPPER(outcome)='WIN')  AS wins,
        COUNT(*) FILTER (WHERE UPPER(outcome)='LOSS') AS losses,
        ROUND(AVG(CASE WHEN UPPER(outcome)='LOSS'
            THEN COALESCE(mae, mae_r, 0) END)::numeric, 3) AS mae_bij_loss,
        ROUND(AVG(CASE WHEN UPPER(outcome)='WIN'
            THEN COALESCE(mae, mae_r, 0) END)::numeric, 3) AS mae_bij_win
    FROM public.experience_trades
    WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
      AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
      AND COALESCE(exit_time, updated_at) >= NOW() - INTERVAL '1 day' * %s
    """, (days,))

    if rows:
        return {k: safe_float(v) for k, v in rows[0].items()}
    return {}


def get_coin_performance(conn, days: int = 60) -> List[Dict]:
    """
    Win rate en PnL per coin.
    Detecteert welke coins op de blacklist moeten of juist toppers zijn.
    """
    return run_query(conn, """
    SELECT
        COALESCE(coin, '?') AS coin,
        COUNT(*) AS n,
        COUNT(*) FILTER (WHERE UPPER(outcome)='WIN') AS wins,
        COUNT(*) FILTER (WHERE UPPER(outcome)='LOSS') AS losses,
        ROUND(
            COUNT(*) FILTER (WHERE UPPER(outcome)='WIN')::numeric
            / NULLIF(COUNT(*),0) * 100, 1
        ) AS win_rate,
        ROUND(SUM(
            CASE WHEN UPPER(outcome)='WIN'  THEN  ABS(COALESCE(pnl_eur,0))
                 WHEN UPPER(outcome)='LOSS' THEN -ABS(COALESCE(pnl_eur,0))
                 ELSE 0 END
        )::numeric, 4) AS total_pnl,
        ROUND(AVG(COALESCE(pnl_r, result_r, 0))::numeric, 2) AS avg_r
    FROM public.experience_trades
    WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
      AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
      AND COALESCE(exit_time, updated_at) >= NOW() - INTERVAL '1 day' * %s
    GROUP BY 1
    HAVING COUNT(*) >= 5
    ORDER BY total_pnl DESC
    """, (days,))


