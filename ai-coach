# ── TRADE FLOW ANALYSE ────────────────────────────────────────
def analyseer_trade_flow(conn) -> Dict:
    """
    Analyseert de volledige trade flow: van signaal tot gesloten trade.
    Detecteert bottlenecks — waar gaat het mis in het proces?

    Signal (multi_coin_score) → Pending Approval → Live Trade → Closed
    """
    try:
        # Signalen gegenereerd (pending_approvals)
        signalen = run_scalar(conn, """
        SELECT COUNT(*) FROM public.pending_approvals
        WHERE aangemaakt >= NOW() - INTERVAL '7 days'
        """, default=0)

        # Goedgekeurde signalen
        goedgekeurd = run_scalar(conn, """
        SELECT COUNT(*) FROM public.pending_approvals
        WHERE UPPER(COALESCE(status,'')) = 'APPROVED'
          AND aangemaakt >= NOW() - INTERVAL '7 days'
        """, default=0)

        # Verlopen signalen
        verlopen = run_scalar(conn, """
        SELECT COUNT(*) FROM public.pending_approvals
        WHERE COALESCE(expires_at, aangemaakt + INTERVAL '4 hours') < NOW()
          AND UPPER(COALESCE(status,'PENDING')) = 'PENDING'
          AND aangemaakt >= NOW() - INTERVAL '7 days'
        """, default=0)

        # Live trades aangemaakt
        live = run_scalar(conn, """
        SELECT COUNT(*) FROM public.experience_trades
        WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
          AND COALESCE(created_at, entry_time) >= NOW() - INTERVAL '7 days'
        """, default=0)

        # Gesloten trades
        gesloten = run_scalar(conn, """
        SELECT COUNT(*) FROM public.experience_trades
        WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
          AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
          AND COALESCE(exit_time, updated_at) >= NOW() - INTERVAL '7 days'
        """, default=0)

        # Bottleneck detectie
        n_sig = safe_int(signalen)
        n_goed = safe_int(goedgekeurd)
        n_live = safe_int(live)
        n_ges  = safe_int(gesloten)

        bottlenecks = []
        if n_sig > 0 and n_goed / max(n_sig, 1) < 0.05:
            bottlenecks.append(f"Veel signalen ({n_sig}), maar slechts {n_goed} goedgekeurd — score drempel te hoog?")
        if n_goed > 0 and n_live < n_goed * 0.5:
            bottlenecks.append(f"Signalen goedgekeurd maar niet uitgevoerd — max trades bereikt?")
        if n_live > 0 and n_ges < n_live * 0.3:
            bottlenecks.append(f"Trades open maar niet gesloten — max houdtijd niet bereikt of bot probleem")

        # Gem. tijd van signaal tot entry
        timing = run_query(conn, """
        SELECT ROUND(AVG(
            EXTRACT(EPOCH FROM (COALESCE(t.entry_time, t.created_at) - p.aangemaakt))/60
        )::numeric, 1) AS min_signaal_tot_entry
        FROM public.pending_approvals p
        JOIN public.experience_trades t ON t.coin = p.coin
        WHERE p.aangemaakt >= NOW() - INTERVAL '7 days'
          AND UPPER(COALESCE(t.source,'')) IN ('REAL','LIVE')
        """)
        gem_min = safe_float((timing[0].get("min_signaal_tot_entry") if timing else None), 0)

        data = {
            "signalen_7d":     n_sig,
            "goedgekeurd_7d":  n_goed,
            "verlopen_7d":     safe_int(verlopen),
            "live_7d":         n_live,
            "gesloten_7d":     n_ges,
            "conversie_pct":   round(n_live / max(n_sig, 1) * 100, 1),
            "gem_min_entry":   gem_min,
            "bottlenecks":     bottlenecks,
        }
        sla_geheugen_op(conn, "trade_flow", "7d", data)
        return data

    except Exception as e:
        log(f"⚠️ Trade flow analyse: {e}")
        return {}


def format_trade_flow(data: Dict) -> str:
    if not data:
        return ""
    r = (
        f"🔄 TRADE FLOW (7 dagen):\n"
        f"• Signalen:     {data.get('signalen_7d',0)}\n"
        f"• Goedgekeurd:  {data.get('goedgekeurd_7d',0)}\n"
        f"• Verlopen:     {data.get('verlopen_7d',0)}\n"
        f"• Live trades:  {data.get('live_7d',0)} ({data.get('conversie_pct',0):.1f}% conversie)\n"
        f"• Gesloten:     {data.get('gesloten_7d',0)}\n"
    )
    if data.get("gem_min_entry"):
        r += f"• Gem. entry tijd: {data['gem_min_entry']:.1f} min na signaal\n"
    if data.get("bottlenecks"):
        r += "⚠️ Bottlenecks:\n"
        for b in data["bottlenecks"]:
            r += f"  → {b}\n"
    r += "\n"
    return r


