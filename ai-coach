def format_systeem_audit(audit: Dict) -> str:
    score = audit.get("score", 100)
    kritiek = audit.get("kritieke_fouten", 0)
    waarsch = audit.get("waarschuwingen", 0)
    emoji = "✅" if score >= 90 else "⚠️" if score >= 70 else "🔴"

    r = f"🔍 SYSTEEM AUDIT: {score}/100 {emoji}\n"
    r += f"• Kritieke fouten: {kritiek} | Waarschuwingen: {waarsch}\n"

    # Toon alleen mislukte checks
    fouten = [c for c in audit.get("checks", []) if not c["ok"]]
    if fouten:
        r += "Problemen:\n"
        for f in fouten[:5]:
            ernst_emoji = "🔴" if f["ernst"] == "KRITIEK" else "🟡"
            r += f"  {ernst_emoji} {f['naam']}: {f['bericht']}\n"
    r += "\n"
    return r


# ── COACH DAGBOEK ─────────────────────────────────────────────
def schrijf_dagboek(conn, rapport: str, beslissingen: List[str],
                    anomalieen: List[Dict], totalen: Dict,
                    start_tijd: datetime) -> None:
    """
    Schrijft een volledige journaalregel voor elke coach run.
    Zodat je letterlijk elke run terugkunt lezen — wat was de situatie,
    welke beslissingen zijn genomen, waren er problemen?
    """
    try:
        run_duur = (now_utc() - start_tijd).total_seconds()
        samenvatting = (
            f"WR={safe_float(totalen.get('win_rate')):.1f}% | "
            f"PF={safe_float(totalen.get('profit_factor')):.2f} | "
            f"PnL=€{safe_float(totalen.get('net_pnl')):.4f} | "
            f"{safe_int(totalen.get('n'))} trades"
        )
        metrics_json = {
            "win_rate": safe_float(totalen.get("win_rate")),
            "profit_factor": safe_float(totalen.get("profit_factor")),
            "net_pnl": safe_float(totalen.get("net_pnl")),
            "n_trades": safe_int(totalen.get("n")),
        }
        with conn.cursor() as cur:
            cur.execute("""
            INSERT INTO public.coach_dagboek(samenvatting, metrics, beslissingen, anomalieen, run_duur_sec)
            VALUES(%s, %s::jsonb, %s, %s, %s)
            """, (
                samenvatting,
                json.dumps(metrics_json, default=str),
                "\n".join(beslissingen) if beslissingen else "Geen aanpassingen",
                "\n".join(a["beschrijving"] for a in anomalieen) if anomalieen else "Geen",
                round(run_duur, 1),
            ))
        conn.commit()
        log(f"📖 Dagboek geschreven ({run_duur:.0f}s run)")
    except Exception as e:
        log(f"⚠️ Dagboek fout: {e}")


def get_dagboek_history(conn, n: int = 10) -> List[Dict]:
    return run_query(conn, """
    SELECT datum, tijdstip, samenvatting, beslissingen, anomalieen, run_duur_sec
    FROM public.coach_dagboek
    ORDER BY tijdstip DESC LIMIT %s
    """, (n,))


def format_dagboek_history(rows: List[Dict]) -> str:
    if not rows:
        return ""
    r = f"📖 COACH DAGBOEK (laatste {len(rows)} runs):\n"
    for row in rows:
        datum = safe_str(row.get("datum", ""))
        samenvatting = safe_str(row.get("samenvatting", ""))
        duur = safe_float(row.get("run_duur_sec", 0))
        r += f"• {datum}: {samenvatting} ({duur:.0f}s)\n"
    r += "\n"
    return r


# ── GEHEUGEN ZOEKEN ───────────────────────────────────────────
def zoek_geheugen(conn, query: str) -> List[Dict]:
    """
    Doorzoekt het coach geheugen op een zoekterm.
    Zo kan de coach zijn eigen eerdere beslissingen terugvinden.
    """
    return run_query(conn, """
    SELECT type, sleutel, waarde, bijgewerkt
    FROM public.coach_memory
    WHERE LOWER(waarde) LIKE LOWER(%s)
       OR LOWER(sleutel) LIKE LOWER(%s)
       OR LOWER(type) LIKE LOWER(%s)
    ORDER BY bijgewerkt DESC LIMIT 20
    """, (f"%{query}%", f"%{query}%", f"%{query}%"))


def haal_volledig_geheugen_op(conn) -> Dict:
    """
    Haalt het volledig coach geheugen op, gegroepeerd per type.
    Geeft de coach een compleet beeld van alles wat hij eerder heeft ontdekt.
    """
    alle_rows = run_query(conn, """
    SELECT type, sleutel, waarde, bijgewerkt
    FROM public.coach_memory
    ORDER BY type, bijgewerkt DESC
    """)

    geheugen: Dict[str, Dict] = {}
    for row in alle_rows:
        type_  = safe_str(row.get("type"))
        sleutel = safe_str(row.get("sleutel"))
        waarde = row.get("waarde")
        if type_ not in geheugen:
            geheugen[type_] = {}
        try:
            geheugen[type_][sleutel] = json.loads(waarde) if waarde else None
        except Exception:
            geheugen[type_][sleutel] = waarde

    return geheugen


# ── ENV VARIABELEN MONITOR ────────────────────────────────────
def monitor_env_variabelen(conn) -> Dict:
    """
    Leest alle relevante ENV variabelen en vergelijkt ze met bot_state.
    Detecteert conflicten: als ENV anders is dan bot_state,
    weet de coach dat er een mismatch is.
    """
    import os
    env_vars = {
        "MIN_SCORE_TO_TRADE":   os.getenv("MIN_SCORE_TO_TRADE", "92"),
        "ATR_MULTIPLIER":       os.getenv("ATR_MULTIPLIER", "1.6"),
        "ATR_TARGET_R":         os.getenv("ATR_TARGET_R", "2.5"),
        "TRADING_HOURS_START":  os.getenv("TRADING_HOURS_START", "9"),
        "TRADING_HOURS_END":    os.getenv("TRADING_HOURS_END", "17"),
        "MAX_PER_TRADE_EUR":    os.getenv("MAX_PER_TRADE_EUR", "0.50"),
        "DAILY_STOP_LOSS_EUR":  os.getenv("DAILY_STOP_LOSS_EUR", "5.00"),
        "COIN_COOLDOWN_HOURS":  os.getenv("COIN_COOLDOWN_HOURS", "48"),
        "MAX_HOLD_HOURS":       os.getenv("MAX_HOLD_HOURS", "24"),
        "BLACKLIST_MIN_TRADES": os.getenv("BLACKLIST_MIN_TRADES", "15"),
        "BLACKLIST_MAX_WINRATE":os.getenv("BLACKLIST_MAX_WINRATE", "0.35"),
        "RSI_MIN":              os.getenv("RSI_MIN", "40"),
        "RSI_MAX":              os.getenv("RSI_MAX", "60"),
        "EDGE_DECAY_THRESHOLD": os.getenv("EDGE_DECAY_THRESHOLD", "8.0"),
    }

    # Vergelijk met bot_state
    conflicten: List[Dict] = []
    for key, env_val in env_vars.items():
        state_key = key.lower()
        state_val = get_bot_state(conn, state_key, None)
        if state_val and state_val != env_val:
            conflicten.append({
                "parameter": key,
                "env_waarde": env_val,
                "state_waarde": state_val,
            })

    # Sla ENV snapshot op
    sla_geheugen_op(conn, "env_vars", "snapshot", env_vars)
    if conflicten:
        sla_geheugen_op(conn, "env_vars", "conflicten", conflicten)
        log(f"⚠️ {len(conflicten)} ENV/state conflicten gedetecteerd")

    return {"env_vars": env_vars, "conflicten": conflicten}


def format_env_rapport(data: Dict) -> str:
