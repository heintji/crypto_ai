def sla_geheugen_op(conn, type_: str, sleutel: str, waarde: Any, score: float = 0) -> None:
    try:
        w = json.dumps(waarde, ensure_ascii=False) if not isinstance(waarde, str) else waarde
        with conn.cursor() as cur:
            cur.execute("""
            INSERT INTO public.coach_memory(type, sleutel, waarde, score, bijgewerkt)
            VALUES(%s, %s, %s, %s, NOW())
            ON CONFLICT(type, sleutel) DO UPDATE
                SET waarde=EXCLUDED.waarde, score=EXCLUDED.score, bijgewerkt=NOW()
            """, (type_, sleutel, w, score))
        conn.commit()
    except Exception as e:
        log(f"⚠️ Geheugen opslaan: {e}")


def haal_geheugen_op(conn, type_: str, sleutel: str) -> Optional[Any]:
    try:
        rows = run_query(conn, """
        SELECT waarde FROM public.coach_memory WHERE type=%s AND sleutel=%s LIMIT 1
        """, (type_, sleutel))
        if rows:
            val = rows[0]["waarde"]
            try:
                return json.loads(val)
            except Exception:
                return val
    except Exception:
        pass
    return None


