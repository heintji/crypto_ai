# FEATURE 2: DRAWDOWN BESCHERMING
# ============================================================
def check_drawdown_bescherming(conn) -> Optional[str]:
    """Verlaagt positiegrootte automatisch bij grote drawdown."""
    dd = get_drawdown_data(conn)
    huidige = safe_float(get_bot_state(conn, "max_per_trade_eur", str(MAX_PER_TRADE_EUR)))
    origineel = MAX_PER_TRADE_EUR

    if dd["is_drawdown"] and huidige > origineel * 0.5:
        nieuwe = round(origineel * 0.5, 2)
        set_bot_state(conn, "max_per_trade_eur", str(nieuwe))
        set_bot_state(conn, "drawdown_modus", "true")
        bericht = f"drawdown {dd['huidige_dd']:.1f}R — positie verlaagd: €{huidige:.2f} → €{nieuwe:.2f}"
        log(f"🔴 {bericht}")
        stuur_alert("DRAWDOWN BESCHERMING",
                    f"Drawdown: {dd['huidige_dd']:.1f}R (grens: {DRAWDOWN_REDUCE_THRESHOLD}R)",
                    f"Positie verlaagd naar €{nieuwe:.2f}")
        return bericht

    elif not dd["is_drawdown"] and get_bot_state(conn, "drawdown_modus", "false") == "true":
        set_bot_state(conn, "max_per_trade_eur", str(origineel))
        set_bot_state(conn, "drawdown_modus", "false")
        bericht = f"drawdown hersteld — positie terug naar €{origineel:.2f}"
        log(f"✅ {bericht}")
        stuur_alert("DRAWDOWN HERSTELD",
                    f"Systeem normaal (dd: {dd['huidige_dd']:.1f}R)",
                    f"Positie terug naar €{origineel:.2f}")
        return bericht

    return None


