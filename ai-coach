def voorspel_regime(conn) -> Dict:
    """Analyseert BTC regime patroon en geeft voorspelling."""
    try:
        rows = run_query(conn, """
        SELECT regime, strength, close, ema200
        FROM public.btc_regime_4h
        ORDER BY open_time DESC LIMIT 100
        """)
        if not rows:
            return {"voorspelling": "ONBEKEND", "betrouwbaarheid": 0, "huidig": "?"}

        huidig    = safe_str(rows[0].get("regime"), "UNKNOWN")
        strength  = safe_float(rows[0].get("strength"))

        # Hoelang al in dit regime?
        duur = sum(1 for r in rows if safe_str(r.get("regime")) == huidig)

        regimes = [safe_str(r.get("regime")) for r in rows[:10]]
        bull_n  = regimes.count("BULL")
        bear_n  = regimes.count("BEAR")

        if huidig == "BULL" and duur > 20 and strength < 30:
            voorspelling = "RANGE"
            reden = "BULL uitgeput (lange duur + lage sterkte)"
        elif huidig == "BEAR" and duur > 15:
            voorspelling = "RANGE"
            reden = "BEAR verzwakt na lange periode"
        elif huidig == "RANGE" and bull_n > bear_n:
            voorspelling = "BULL"
            reden = "Historisch meer BULL dan BEAR"
        else:
            voorspelling = huidig
            reden = "Regime stabiel"

        resultaat = {
            "huidig": huidig, "strength": strength,
            "duur": duur, "voorspelling": voorspelling,
            "reden": reden, "betrouwbaarheid": min(60 + duur, 85),
        }
        sla_geheugen_op(conn, "regime", "voorspelling", resultaat)
        return resultaat

    except Exception as e:
        log(f"⚠️ Regime voorspelling: {e}")
        return {"voorspelling": "ONBEKEND", "betrouwbaarheid": 0, "huidig": "?"}


