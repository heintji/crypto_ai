def _get_data_dir() -> str:
    d = (os.getenv("DATA_DIR") or "").strip()
    if d:
        return d
    return "/data" if os.path.isdir("/data") else "/tmp/data"


def lees_live_state() -> Dict:
    """Leest live_state.json — alle open live trades."""
    path = os.path.join(_get_data_dir(), "live_state.json")
    try:
        if os.path.exists(path):
            with open(path) as f:
                data = json.load(f)
            posities = data.get("positions", {})
            return {
                "beschikbaar": True,
                "n_posities": len(posities),
                "posities": posities,
                "open_trades": data.get("open_trades", []),
            }
    except Exception as e:
        log(f"⚠️ live_state.json: {e}")
    return {"beschikbaar": False, "n_posities": 0, "posities": {}}


def lees_shadow_state() -> Dict:
    """Leest shadow_trades.json — alle open shadow trades."""
    path = os.path.join(_get_data_dir(), "shadow_trades.json")
    try:
        if os.path.exists(path):
            with open(path) as f:
                data = json.load(f)
            posities = data.get("positions", {})
            stats = data.get("stats", {})
            return {
                "beschikbaar": True,
                "n_posities": len(posities),
                "posities": posities,
                "stats": stats,
            }
    except Exception as e:
        log(f"⚠️ shadow_trades.json: {e}")
    return {"beschikbaar": False, "n_posities": 0}


def lees_account_snapshot() -> Dict:
    """Leest account_snapshot.json — laatste Bitvavo portfolio snapshot."""
    for path in ["/data/account_snapshot.json",
                 os.path.join(_get_data_dir(), "account_snapshot.json")]:
        try:
            if os.path.exists(path):
                with open(path) as f:
                    data = json.load(f)
                return {
