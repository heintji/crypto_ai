# FEATURE 15: BACKTEST NIEUWE PARAMETERS
# ============================================================
def backtest_score_drempel(conn, nieuwe_drempel: int, days: int = 90) -> Dict:
    """
    Simuleert wat de resultaten zouden zijn geweest met een andere score drempel.
    Vergelijkt huidige drempel vs nieuwe drempel.
    """
    # Resultaten met huidige drempel
    huidig = run_query(conn, """
    SELECT COUNT(*) AS n,
        ROUND(COUNT(*) FILTER (WHERE UPPER(outcome)='WIN')::numeric/NULLIF(COUNT(*),0)*100,1) AS win_rate,
        ROUND(SUM(CASE WHEN UPPER(outcome)='WIN' THEN ABS(COALESCE(pnl_eur,0))
                       WHEN UPPER(outcome)='LOSS' THEN -ABS(COALESCE(pnl_eur,0)) ELSE 0 END)::numeric,4) AS pnl
    FROM public.experience_trades
    WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
      AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
      AND COALESCE(score,0) >= %s
      AND COALESCE(exit_time,updated_at) >= NOW() - INTERVAL '1 day' * %s
    """, (MIN_SCORE_TO_TRADE, days))

    # Resultaten met nieuwe drempel
    nieuw = run_query(conn, """
    SELECT COUNT(*) AS n,
        ROUND(COUNT(*) FILTER (WHERE UPPER(outcome)='WIN')::numeric/NULLIF(COUNT(*),0)*100,1) AS win_rate,
        ROUND(SUM(CASE WHEN UPPER(outcome)='WIN' THEN ABS(COALESCE(pnl_eur,0))
                       WHEN UPPER(outcome)='LOSS' THEN -ABS(COALESCE(pnl_eur,0)) ELSE 0 END)::numeric,4) AS pnl
    FROM public.experience_trades
    WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
      AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
      AND COALESCE(score,0) >= %s
      AND COALESCE(exit_time,updated_at) >= NOW() - INTERVAL '1 day' * %s
    """, (nieuwe_drempel, days))

    h = dict(huidig[0]) if huidig else {}
    n = dict(nieuw[0])  if nieuw  else {}

    wr_verschil  = safe_float(n.get("win_rate")) - safe_float(h.get("win_rate"))
    pnl_verschil = safe_float(n.get("pnl")) - safe_float(h.get("pnl"))
    trade_verschil = safe_int(n.get("n")) - safe_int(h.get("n"))

    resultaat = {
        "huidige_drempel":  MIN_SCORE_TO_TRADE,
        "nieuwe_drempel":   nieuwe_drempel,
        "huidig_n":         safe_int(h.get("n")),
        "huidig_wr":        safe_float(h.get("win_rate")),
        "huidig_pnl":       safe_float(h.get("pnl")),
        "nieuw_n":          safe_int(n.get("n")),
        "nieuw_wr":         safe_float(n.get("win_rate")),
        "nieuw_pnl":        safe_float(n.get("pnl")),
        "wr_verschil":      round(wr_verschil, 1),
        "pnl_verschil":     round(pnl_verschil, 4),
        "trade_verschil":   trade_verschil,
        "aanbeveling":      "VERHOOG" if wr_verschil > 3 else "VERLAAG" if wr_verschil < -3 else "HOUD",
    }
    sla_geheugen_op(conn, "backtest", f"score_{nieuwe_drempel}", resultaat)
    return resultaat


def format_backtest_rapport(conn, days: int) -> str:
    """Test score drempel +3 en -3 en geeft advies."""
    r = "🧪 BACKTEST SCORE DREMPEL:\n"
    for test_drempel in [MIN_SCORE_TO_TRADE - 3, MIN_SCORE_TO_TRADE + 3]:
        if test_drempel < 75 or test_drempel > 99:
            continue
        bt = backtest_score_drempel(conn, test_drempel, days)
        pijl = "↑" if bt.get("wr_verschil", 0) > 0 else "↓"
        r += (
            f"• Drempel {test_drempel}: "
            f"WR {bt.get('nieuw_wr',0):.1f}% ({bt.get('wr_verschil',0):+.1f}%) {pijl} | "
            f"{bt.get('nieuw_n',0)} trades ({bt.get('trade_verschil',0):+d}) | "
            f"PnL {bt.get('pnl_verschil',0):+.4f}€\n"
        )
    r += f"→ Huidig optimaal: score ≥ {MIN_SCORE_TO_TRADE}\n\n"
    return r


