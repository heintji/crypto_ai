def send_whatsapp(message: str) -> bool:
    """
    Stuurt WhatsApp bericht via Twilio.
    Identieke implementatie in alle bestanden.
    Grote rapporten worden automatisch gesplitst als >1600 tekens.
    """
    if not all([TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN,
                TWILIO_WHATSAPP_FROM, TWILIO_WHATSAPP_TO]):
        log(f"WhatsApp (geen Twilio): {message[:80]}")
        return False

    # WhatsApp max 1600 tekens — splits grote berichten
    MAX_LEN = 1550
    if len(message) <= MAX_LEN:
        chunks = [message]
    else:
        chunks = []
        lines  = message.split("\n")
        current = ""
        for line in lines:
            if len(current) + len(line) + 1 > MAX_LEN:
                if current:
                    chunks.append(current.strip())
                current = line + "\n"
            else:
                current += line + "\n"
        if current.strip():
            chunks.append(current.strip())

    success = True
    for i, chunk in enumerate(chunks):
        prefix = f"[{i+1}/{len(chunks)}] " if len(chunks) > 1 else ""
        try:
            resp = requests.post(
                f"https://api.twilio.com/2010-04-01/Accounts"
                f"/{TWILIO_ACCOUNT_SID}/Messages.json",
                auth=(TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN),
                data={
                    "From": TWILIO_WHATSAPP_FROM,
                    "To":   TWILIO_WHATSAPP_TO,
                    "Body": prefix + chunk,
                },
                timeout=15,
            )
            if resp.status_code not in (200, 201):
                log(f"❌ WhatsApp fout {resp.status_code}")
                success = False
            else:
                log(f"✅ WhatsApp deel {i+1}/{len(chunks)} verzonden ({len(chunk)} tekens)")
        except Exception as e:
            log(f"❌ WhatsApp exception: {e}")
            success = False

    return success


