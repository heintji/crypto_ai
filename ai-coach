def analyseer_volatiliteit(conn, days: int) -> Dict:
    """
    Analyseert hoe goed de bot presteert in verschillende volatiliteitsomstandigheden.
    Hoge volatiliteit = grote ATR = grotere stops = meer risico.
    """
    rows = run_query(conn, """
    SELECT
        COALESCE(market_condition, 'normaal') AS conditie,
        COUNT(*) AS n,
        ROUND(COUNT(*) FILTER (WHERE UPPER(outcome)='WIN')::numeric/NULLIF(COUNT(*),0)*100,1) AS win_rate,
        ROUND(AVG(COALESCE(pnl_r,result_r,0))::numeric,2) AS avg_r,
        ROUND(AVG(COALESCE(mae,mae_r,0))::numeric,2) AS gem_mae
    FROM public.experience_trades
    WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
      AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
      AND COALESCE(exit_time,updated_at) >= NOW() - INTERVAL '1 day' * %s
    GROUP BY 1 HAVING COUNT(*) >= 3 ORDER BY win_rate DESC
    """, (days,))

    return {"condities": rows}


# ============================================================
# FEATURE 11: HOUDTIJD OPTIMALISATIE
# ============================================================
def analyseer_houdtijd(conn, days: int) -> Dict:
    """
    Analyseert optimale houdtijd per setup type.
    Detecteert of trades te vroeg of te laat worden gesloten.
    Vergelijkt houdtijd van winners vs losers.
    """
    rows = run_query(conn, """
    SELECT
        COALESCE(setup_type,'UNKNOWN') AS setup,
        UPPER(outcome) AS uitkomst,
        ROUND(AVG(
            EXTRACT(EPOCH FROM (COALESCE(exit_time,updated_at) - COALESCE(entry_time,created_at)))/3600
        )::numeric,1) AS gem_uren,
        ROUND(MIN(
            EXTRACT(EPOCH FROM (COALESCE(exit_time,updated_at) - COALESCE(entry_time,created_at)))/3600
        )::numeric,1) AS min_uren,
        ROUND(MAX(
            EXTRACT(EPOCH FROM (COALESCE(exit_time,updated_at) - COALESCE(entry_time,created_at)))/3600
        )::numeric,1) AS max_uren,
        COUNT(*) AS n
    FROM public.experience_trades
    WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
      AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
      AND COALESCE(exit_time,updated_at) >= NOW() - INTERVAL '1 day' * %s
      AND entry_time IS NOT NULL
      AND exit_time IS NOT NULL
    GROUP BY 1,2 HAVING COUNT(*) >= 3 ORDER BY setup, uitkomst
    """, (days,))

    # Groepeer per setup
    per_setup: Dict[str, Dict] = {}
    for r in rows:
        setup    = safe_str(r.get("setup"))
        uitkomst = safe_str(r.get("uitkomst"))
        if setup not in per_setup:
            per_setup[setup] = {}
        per_setup[setup][uitkomst] = {
            "gem_uren": safe_float(r.get("gem_uren")),
            "n": safe_int(r.get("n")),
        }

    # Detecteer anomalieën: als verliezende trades langer open staan dan winners
    anomalieen = []
    for setup, data in per_setup.items():
        win_uur  = data.get("WIN",  {}).get("gem_uren", 0)
        loss_uur = data.get("LOSS", {}).get("gem_uren", 0)
        if loss_uur > win_uur * 1.5 and win_uur > 0:
            anomalieen.append(f"{setup}: verliezen staan {loss_uur:.1f}u open vs {win_uur:.1f}u bij wins — overweeg kortere max houdtijd")

    sla_geheugen_op(conn, "houdtijd", f"analyse_{days}d", {"per_setup": per_setup, "anomalieen": anomalieen})
    return {"per_setup": per_setup, "anomalieen": anomalieen}


def format_houdtijd_rapport(data: Dict) -> str:
    if not data:
        return ""
    r = "⏱️ HOUDTIJD ANALYSE:\n"
    for setup, info in list(data.get("per_setup", {}).items())[:5]:
        win_u  = info.get("WIN",  {}).get("gem_uren", 0)
        loss_u = info.get("LOSS", {}).get("gem_uren", 0)
        if win_u > 0 or loss_u > 0:
            r += f"• {setup}: WIN {win_u:.1f}u | LOSS {loss_u:.1f}u\n"
    if data.get("anomalieen"):
        r += "⚠️ Anomalieën:\n"
        for a in data["anomalieen"][:2]:
            r += f"  → {a}\n"
    r += "\n"
    return r


