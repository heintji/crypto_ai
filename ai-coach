def check_alle_alarmen(conn) -> List[Dict]:
    """
    Controleert alle alarm condities en geeft lijst terug van actieve alarmen.
    Elk alarm heeft: niveau (KRITIEK/HOOG/LAAG), bericht, actie.
    """
    alarmen = []

    try:
        # 1. Win rate alarm (7 dagen)
        rows = run_query(conn, """
        SELECT COUNT(*) AS n,
            COUNT(*) FILTER (WHERE UPPER(outcome)='WIN') AS wins
        FROM public.experience_trades
        WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
          AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
          AND COALESCE(exit_time,updated_at) >= NOW() - INTERVAL '7 days'
        """)
        if rows:
            n = safe_int(rows[0].get("n"))
            wins = safe_int(rows[0].get("wins"))
            wr = (wins / n * 100) if n > 0 else 0
            if n >= 5 and wr < 35:
                alarmen.append({
                    "niveau": "KRITIEK",
                    "titel": "WIN RATE KRITIEK LAAG",
                    "bericht": f"Win rate 7d: {wr:.1f}% ({n} trades) — onder 35%",
                    "actie": "Bot tijdelijk pauzeren overwegen"
                })
            elif n >= 5 and wr < 45:
                alarmen.append({
                    "niveau": "HOOG",
                    "titel": "WIN RATE ONDER DOEL",
                    "bericht": f"Win rate 7d: {wr:.1f}% ({n} trades) — onder 45%",
                    "actie": "Score drempel verhogen naar 94+"
                })

        # 2. Profit factor alarm
        pf_rows = run_query(conn, """
        SELECT ROUND(COALESCE(SUM(CASE WHEN UPPER(outcome)='WIN' THEN ABS(COALESCE(pnl_eur,0)) ELSE 0 END),0)
                /NULLIF(SUM(CASE WHEN UPPER(outcome)='LOSS' THEN ABS(COALESCE(pnl_eur,0)) ELSE 0 END),0.001),2) AS pf
        FROM public.experience_trades
        WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
          AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
          AND COALESCE(exit_time,updated_at) >= NOW() - INTERVAL '30 days'
        """)
        if pf_rows:
            pf = safe_float(pf_rows[0].get("pf"))
            if 0 < pf < 1.0:
                alarmen.append({
                    "niveau": "KRITIEK",
                    "titel": "PROFIT FACTOR ONDER 1.0",
                    "bericht": f"PF 30d: {pf:.2f} — systeem verliest geld",
                    "actie": "STOP bot en analyseer alle parameters"
                })
            elif 0 < pf < 1.3:
                alarmen.append({
                    "niveau": "HOOG",
                    "titel": "PROFIT FACTOR LAAG",
                    "bericht": f"PF 30d: {pf:.2f} — onder doel 1.5",
                    "actie": "Score drempel verhogen, slechte setups stoppen"
                })

        # 3. Dagelijks verlies alarm
        dag_rows = run_query(conn, """
        SELECT ROUND(SUM(CASE WHEN UPPER(outcome)='WIN' THEN ABS(COALESCE(pnl_eur,0))
                               WHEN UPPER(outcome)='LOSS' THEN -ABS(COALESCE(pnl_eur,0)) ELSE 0 END)::numeric,4) AS pnl
        FROM public.experience_trades
        WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
          AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
          AND DATE(COALESCE(exit_time,updated_at) AT TIME ZONE 'UTC') = CURRENT_DATE
        """)
        if dag_rows:
            pnl_dag = safe_float(dag_rows[0].get("pnl"))
            if pnl_dag < -4.0:
                alarmen.append({
                    "niveau": "HOOG",
                    "titel": "GROOT DAGVERLIES",
                    "bericht": f"PnL vandaag: €{pnl_dag:.4f} — bijna dagbudget",
                    "actie": "Stuur STOP als dagbudget bereikt"
                })

        # 4. Database gezondheid
        tabel_rows = run_query(conn, """
        SELECT COUNT(*) AS n FROM public.experience_trades
        WHERE COALESCE(exit_time,updated_at) >= NOW() - INTERVAL '48 hours'
          AND UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
        """)
        if tabel_rows:
            recente = safe_int(tabel_rows[0].get("n"))
            if recente == 0:
                # Check of bot actief is
                bot_actief = get_bot_state(conn, "bot_active", "false").lower() == "true"
                if bot_actief:
                    alarmen.append({
                        "niveau": "LAAG",
                        "titel": "GEEN RECENTE TRADES",
                        "bericht": "Geen live trades in afgelopen 48u terwijl bot actief is",
                        "actie": "Controleer scanner en signalen"
                    })

        # 5. Pending approvals verlopen
        verlopen = run_scalar(conn, """
        SELECT COUNT(*) FROM public.pending_approvals
        WHERE expires_at < NOW() AND COALESCE(status,'PENDING') = 'PENDING'
        """, default=0)
        if safe_int(verlopen) > 20:
            alarmen.append({
                "niveau": "LAAG",
                "titel": f"{verlopen} SIGNALEN VERLOPEN",
                "bericht": f"{verlopen} pre-buy signalen verlopen zonder te worden uitgevoerd",
                "actie": "Scanner te streng? Of limieten bereikt?"
            })

    except Exception as e:
        log(f"⚠️ Alarm check fout: {e}")

    # Sla alarmen op in bot_state voor dashboard
    if alarmen:
        set_bot_state(conn, "coach_alarmen", json.dumps(alarmen, ensure_ascii=False))
        kritiek = [a for a in alarmen if a["niveau"] == "KRITIEK"]
        hoog    = [a for a in alarmen if a["niveau"] == "HOOG"]
        if kritiek or hoog:
            for alarm in kritiek + hoog:
                stuur_alert(alarm["titel"], alarm["bericht"], alarm["actie"])

    log(f"🚨 {len(alarmen)} alarmen gevonden ({sum(1 for a in alarmen if a['niveau']=='KRITIEK')} kritiek)")
    return alarmen


def format_alarm_rapport(alarmen: List[Dict]) -> str:
    if not alarmen:
        return "🟢 GEEN ALARMEN — alles in orde\n\n"
