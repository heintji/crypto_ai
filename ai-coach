              f"Dagverlies €{dv:.4f} ≥ limiet €{DAILY_STOP_LOSS_EUR}", "KRITIEK", 20)
    elif dv >= DAILY_STOP_LOSS_EUR * 0.8:
        check("dagverlies", False,
              f"Dagverlies €{dv:.4f} — 80% van limiet bereikt", "HOOG", 5)
    else:
