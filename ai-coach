def analyseer_score_drempel(score_data: List[Dict]) -> Dict[str, Any]:
    """
    Bepaalt de optimale score drempel op basis van win rate per range.
    Aanbeveling: gebruik de range met hoogste win rate als minimum.
    """
    if not score_data:
        return {"aanbeveling": MIN_SCORE_TO_TRADE, "reden": "Geen data"}

    beste_range  = None
    beste_wr     = 0.0
    huidig_wr    = 0.0

    for r in score_data:
        wr    = safe_float(r.get("win_rate"))
        rng   = safe_str(r.get("score_range"))
        n     = safe_int(r.get("n"))

        if rng in ("85-89", "85+"):
            huidig_wr = wr

        if wr > beste_wr and n >= MIN_TRADES_FOR_ANALYSE:
            beste_wr    = wr
            beste_range = rng

    # Vertaal range naar concrete drempel
    drempel_map = {
        "80-84": 80, "85-89": 85, "90-94": 90, "95+": 95
    }
    nieuwe_drempel = drempel_map.get(beste_range, MIN_SCORE_TO_TRADE)

    verschil = nieuwe_drempel - MIN_SCORE_TO_TRADE
    if verschil > 0:
        reden = f"Score {beste_range} heeft {beste_wr:.1f}% WR — hoger dan huidige {huidig_wr:.1f}% bij {MIN_SCORE_TO_TRADE}+"
    elif verschil < 0:
        reden = f"Lagere score drempel laat toe toe dat meer trades met goede WR worden genomen"
    else:
        reden = f"Huidige drempel {MIN_SCORE_TO_TRADE} is al optimaal"

    return {
        "huidig":      MIN_SCORE_TO_TRADE,
        "aanbeveling": nieuwe_drempel,
        "verschil":    verschil,
        "beste_wr":    beste_wr,
        "reden":       reden,
    }


def analyseer_trading_uren(uur_data: List[Dict]) -> Dict[str, Any]:
    """
    Bepaalt optimale trading uren op basis van win rate per uur.
    Vergelijkt met huidige TRADING_HOURS_START / END instellingen.
    """
    if not uur_data:
        return {"aanbeveling_start": TRADING_HOURS_START, "aanbeveling_end": TRADING_HOURS_END}

    beste_uren  = []
    slechte_uren = []

    for r in uur_data:
        uur = safe_int(r.get("uur"))
        wr  = safe_float(r.get("win_rate"))
        n   = safe_int(r.get("n"))
        if n < 3:
            continue
        if wr >= 60:
            beste_uren.append(uur)
        elif wr < 45:
            slechte_uren.append(uur)

    # Vind vroegste beste uur als start aanbeveling
    nieuwe_start = min(beste_uren) if beste_uren else TRADING_HOURS_START
    nieuwe_end   = max(beste_uren) + 1 if beste_uren else TRADING_HOURS_END

    # Maak redelijk (tussen 6 en 23)
    nieuwe_start = max(6, min(nieuwe_start, 12))
    nieuwe_end   = max(nieuwe_start + 6, min(nieuwe_end, 23))

    return {
        "huidig_start":      TRADING_HOURS_START,
        "huidig_end":        TRADING_HOURS_END,
        "aanbeveling_start": nieuwe_start,
        "aanbeveling_end":   nieuwe_end,
        "beste_uren":        sorted(beste_uren),
        "slechte_uren":      sorted(slechte_uren),
    }


def analyseer_stop_loss(mae_data: Dict[str, float]) -> Dict[str, Any]:
    """
    Analyseert of de stop loss (ATR multiplier) optimaal is.

    Logica:
    - Als MAE bij WIN trades hoog is → stop laat genoeg ruimte (goed)
    - Als MAE bij LOSS trades laag is → stop is correct
    - Als gem. MAE > 0.7R → stop te krap, verhoog ATR_MULTIPLIER
    - Als gem. MAE < 0.3R → stop te wijd, verlaag ATR_MULTIPLIER
    """
    if not mae_data:
        return {"aanbeveling": ATR_MULTIPLIER, "reden": "Geen MAE data"}

    gem_mae       = safe_float(mae_data.get("gem_mae"))
    mae_bij_loss  = safe_float(mae_data.get("mae_bij_loss"))
    mae_bij_win   = safe_float(mae_data.get("mae_bij_win"))

    huidig = ATR_MULTIPLIER

    if gem_mae > 0.75:
        nieuwe = round(huidig + 0.3, 1)
        reden  = f"Gem. MAE = {gem_mae:.2f}R — stop te krap, prijs heeft ruimte nodig"
        actie  = "VERHOOG"
    elif gem_mae < 0.25 and mae_bij_loss < 0.2:
        nieuwe = round(huidig - 0.2, 1)
        reden  = f"Gem. MAE = {gem_mae:.2f}R bij verlies — stop te wijd, krap het aan"
        actie  = "VERLAAG"
    else:
        nieuwe = huidig
        reden  = f"Gem. MAE = {gem_mae:.2f}R — stop lijkt adequaat"
        actie  = "OK"

    nieuwe = max(1.2, min(nieuwe, 4.0))

    return {
        "huidig":      huidig,
        "aanbeveling": nieuwe,
        "actie":       actie,
        "gem_mae":     gem_mae,
        "mae_bij_loss": mae_bij_loss,
        "mae_bij_win":  mae_bij_win,
        "reden":       reden,
    }


def analyseer_coins(coin_data: List[Dict]) -> Dict[str, List[str]]:
    """
    Analyseert welke coins op de blacklist moeten of
    kunnen worden verwijderd van de blacklist.
    """
    blacklist_toevoegen = []
    whitelist_toevoegen = []
    zorgwekkend         = []

    for r in coin_data:
        coin = safe_str(r.get("coin"))
        n    = safe_int(r.get("n"))
        wr   = safe_float(r.get("win_rate"))
        pnl  = safe_float(r.get("total_pnl"))

        if n >= BLACKLIST_MIN_TRADES and wr < BLACKLIST_MAX_WR * 100:
            blacklist_toevoegen.append(f"{coin} ({wr:.0f}% WR, {n} trades, {pnl:.4f}€)")
        elif n >= BLACKLIST_MIN_TRADES and wr >= 65:
            whitelist_toevoegen.append(f"{coin} ({wr:.0f}% WR, {n} trades)")
        elif n >= 10 and wr < 35:
            zorgwekkend.append(f"{coin} ({wr:.0f}% WR, {n} trades)")

    return {
        "blacklist": blacklist_toevoegen,
        "whitelist": whitelist_toevoegen,
        "zorgwekkend": zorgwekkend,
    }


def analyseer_profit_factor_trend(pf_data: List[Dict]) -> Dict[str, Any]:
    """
    Analyseert of de profit factor verbetert of verslechtert.
    Vergelijkt eerste helft vs tweede helft van de periode.
    """
    if len(pf_data) < 4:
        return {"trend": "onbekend", "actie": "meer data nodig"}

    pfs = [safe_float(r.get("profit_factor")) for r in pf_data]

    eerste_helft  = sum(pfs[:len(pfs)//2]) / max(len(pfs)//2, 1)
    tweede_helft  = sum(pfs[len(pfs)//2:]) / max(len(pfs) - len(pfs)//2, 1)
    laatste_3     = sum(pfs[-3:]) / min(3, len(pfs))
    verandering   = tweede_helft - eerste_helft

    if verandering > 0.2:
        trend = "verbeterend"
        actie = "systeem presteert beter — doorgaan"
    elif verandering < -0.3:
        trend = "verslechterend"
        actie = "aanpassing nodig — zie setup analyse"
    else:
        trend = "stabiel"
        actie = "geen urgente actie nodig"

    return {
        "trend":         trend,
        "actie":         actie,
        "eerste_helft":  round(eerste_helft, 2),
        "tweede_helft":  round(tweede_helft, 2),
        "laatste_3w":    round(laatste_3, 2),
        "verandering":   round(verandering, 2),
        "alle_waarden":  [round(p, 2) for p in pfs],
    }


