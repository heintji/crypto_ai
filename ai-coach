    # 3. Bot state sleutels
    vereiste_keys = ["bot_active", "market_regime", "daily_pnl", "position_size_eur"]
    for key in vereiste_keys:
        val = get_bot_state(conn, key, "__MISSING__")
        if val == "__MISSING__":
            check(f"state_{key}", False, f"bot_state key '{key}' ontbreekt", "MEDIUM", 5)
        else:
            check(f"state_{key}", True, f"{key}={str(val)[:20]}")

    # 4. Bitvavo bereikbaar
    try:
