# ── DATA VERSHEID MONITOR ────────────────────────────────────
def monitor_data_versheid(conn) -> Dict:
    """
    Controleert of alle data vers is.
    - Candles: mogen niet ouder zijn dan 15 min
    - Markt regime: niet ouder dan 4 uur
    - BTC regime: niet ouder dan 1 uur
    - Account snapshot: niet ouder dan 1 dag
    """
    problemen: List[str] = []
    details: Dict = {}

    checks = [
        {
            "naam": "candles_recent",
            "sql": "SELECT MAX(close_time) AS laatste FROM public.candles WHERE interval_='1h'",
            "max_uren": 2,
            "omschrijving": "Candle data",
        },
        {
            "naam": "market_regime",
            "sql": "SELECT MAX(updated_at) AS laatste FROM public.market_regime",
            "max_uren": 6,
            "omschrijving": "Markt regime",
        },
        {
            "naam": "btc_regime",
            "sql": "SELECT MAX(created_at) AS laatste FROM public.btc_regime_4h",
            "max_uren": 5,
            "omschrijving": "BTC regime 4H",
        },
    ]

    for check in checks:
        try:
            rows = run_query(conn, check["sql"])
            if not rows:
                problemen.append(f"{check['omschrijving']}: geen data")
                details[check["naam"]] = {"status": "LEEG"}
                continue

            laatste = rows[0].get("laatste")
            if not laatste:
                problemen.append(f"{check['omschrijving']}: geen timestamp")
                continue

            # Bereken leeftijd
            try:
                if isinstance(laatste, str):
                    ts = datetime.fromisoformat(laatste.replace("Z", "+00:00"))
                else:
                    ts = laatste
                    if ts.tzinfo is None:
                        ts = ts.replace(tzinfo=timezone.utc)

                uren_oud = (now_utc() - ts).total_seconds() / 3600
                details[check["naam"]] = {
                    "uren_oud": round(uren_oud, 1),
                    "status": "OK" if uren_oud < check["max_uren"] else "VEROUDERD",
                }
                if uren_oud > check["max_uren"]:
                    problemen.append(
                        f"{check['omschrijving']} is {uren_oud:.1f}u oud (max {check['max_uren']}u)"
                    )
            except Exception as e:
                problemen.append(f"{check['omschrijving']}: timestamp fout ({e})")

        except Exception as e:
            problemen.append(f"{check['omschrijving']}: query fout ({e})")

    if problemen:
        log(f"⚠️ Data versheid problemen: {len(problemen)}")
        for p in problemen:
            log_event(conn, "BOT", "DATA_VEROUDERD", p, {}, "HOOG")

    sla_geheugen_op(conn, "data_versheid", "laatste", {"problemen": problemen, "details": details})
    return {"problemen": problemen, "details": details}


