# FEATURE 8: R-MULTIPLE VERDELING ANALYSE
# ============================================================
def analyseer_r_verdeling(conn, days: int) -> Dict:
    """
    Analyseert de verdeling van R-multiples.
    Detecteert of de bot consistent goede R haalt of wild varieert.
    Vergelijkt gemiddelde win R vs gemiddelde loss R.
    """
    rows = run_query(conn, """
    SELECT
        ROUND(AVG(CASE WHEN UPPER(outcome)='WIN'  THEN ABS(COALESCE(pnl_r,result_r,0)) END)::numeric,2) AS gem_win_r,
        ROUND(AVG(CASE WHEN UPPER(outcome)='LOSS' THEN ABS(COALESCE(pnl_r,result_r,0)) END)::numeric,2) AS gem_loss_r,
        ROUND(MAX(CASE WHEN UPPER(outcome)='WIN'  THEN ABS(COALESCE(pnl_r,result_r,0)) END)::numeric,2) AS max_win_r,
        ROUND(MAX(CASE WHEN UPPER(outcome)='LOSS' THEN ABS(COALESCE(pnl_r,result_r,0)) END)::numeric,2) AS max_loss_r,
        ROUND(STDDEV(COALESCE(pnl_r,result_r,0))::numeric,2) AS stddev_r,
        COUNT(*) FILTER (WHERE COALESCE(pnl_r,result_r,0) >= 2.0) AS trades_2r_plus,
        COUNT(*) FILTER (WHERE COALESCE(pnl_r,result_r,0) >= 1.0
                           AND COALESCE(pnl_r,result_r,0) < 2.0) AS trades_1_2r,
        COUNT(*) FILTER (WHERE COALESCE(pnl_r,result_r,0) > 0
                           AND COALESCE(pnl_r,result_r,0) < 1.0) AS trades_0_1r,
        COUNT(*) FILTER (WHERE COALESCE(pnl_r,result_r,0) <= -1.0) AS trades_full_loss,
        COUNT(*) AS n
    FROM public.experience_trades
    WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
      AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
      AND COALESCE(exit_time,updated_at) >= NOW() - INTERVAL '1 day' * %s
    """, (days,))

    if not rows:
        return {}

    data = {k: safe_float(v) for k, v in rows[0].items()}

    # Expectancy berekenen
    win_r    = data.get("gem_win_r", 0)
    loss_r   = data.get("gem_loss_r", 1)
    n        = safe_int(rows[0].get("n"))
    wins     = safe_int(run_scalar(conn, """
        SELECT COUNT(*) FROM public.experience_trades
        WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
          AND UPPER(outcome)='WIN'
          AND COALESCE(exit_time,updated_at) >= NOW() - INTERVAL '1 day' * %s
    """, (days,), 0))

    wr = wins / n if n > 0 else 0
    data["expectancy"] = round(wr * win_r - (1 - wr) * loss_r, 3)
    data["wr"] = round(wr * 100, 1)

    # Sla op in geheugen
    sla_geheugen_op(conn, "r_verdeling", f"analyse_{days}d", data)
    return data


def format_r_verdeling_rapport(data: Dict) -> str:
    if not data:
