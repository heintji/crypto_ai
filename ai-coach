                  json.dumps(data or {}, default=str), ernst))
        conn.commit()
    except Exception:
        pass  # Never crash on logging


# ── BOT STATE DIFF ───────────────────────────────────────────
def maak_state_snapshot(conn) -> Dict:
    """
    Maakt een snapshot van de volledige bot_state.
    Vergelijkt met vorige snapshot en logt alle wijzigingen.
    Zo weet de coach PRECIES wat er veranderd is tussen runs.
    """
    try:
        huidige_state = lees_alle_bot_state(conn)
        huidige_state["_snapshot_tijd"] = now_utc().isoformat()

        # Haal vorige snapshot op
        vorige_rows = run_query(conn, """
        SELECT snapshot FROM public.coach_state_snapshots
        ORDER BY tijdstip DESC LIMIT 1
        """)

        diff: Dict[str, Dict] = {}
        if vorige_rows:
            vorige = vorige_rows[0].get("snapshot") or {}
            if isinstance(vorige, str):
                try:
                    vorige = json.loads(vorige)
                except Exception:
                    vorige = {}

            # Detecteer wijzigingen
            alle_keys = set(huidige_state.keys()) | set(vorige.keys())
            for key in alle_keys:
                if key.startswith("_"):
                    continue
                huidig_val = huidige_state.get(key)
                vorig_val  = vorige.get(key)
                if huidig_val != vorig_val:
                    diff[key] = {"oud": vorig_val, "nieuw": huidig_val}

            # Log elke wijziging
            for key, verandering in diff.items():
                log_config_wijziging(conn, key,
                                     str(verandering["oud"]),
                                     str(verandering["nieuw"]),
                                     bron="bot_state_diff",
                                     reden="Automatisch gedetecteerd")

            if diff:
                log(f"🔍 State diff: {len(diff)} wijzigingen gedetecteerd")
                for k, v in list(diff.items())[:5]:
                    log(f"  {k}: {str(v['oud'])[:30]} → {str(v['nieuw'])[:30]}")

        # Sla nieuwe snapshot op
        with conn.cursor() as cur:
            cur.execute("""
            INSERT INTO public.coach_state_snapshots(snapshot, diff_met_vorige)
            VALUES(%s::jsonb, %s::jsonb)
            """, (json.dumps(huidige_state, default=str),
                  json.dumps(diff, default=str)))
        conn.commit()

        sla_geheugen_op(conn, "state_diff", "laatste", diff)
        return diff

    except Exception as e:
        log(f"⚠️ State snapshot fout: {e}")
        return {}


