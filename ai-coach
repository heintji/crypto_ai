# FEATURE 13: FEE IMPACT ANALYSE
# ============================================================
def analyseer_fee_impact(conn, days: int) -> Dict:
    """
    Berekent exacte fee impact op de winst.
    Als fees te hoog zijn relatief aan de winst → score drempel verhogen.
    """
    rows = run_query(conn, """
    SELECT
        COALESCE(SUM(CASE WHEN UPPER(outcome)='WIN' THEN ABS(COALESCE(pnl_eur,0)) ELSE 0 END),0) AS bruto_winst,
        COALESCE(SUM(CASE WHEN UPPER(outcome)='LOSS' THEN ABS(COALESCE(pnl_eur,0)) ELSE 0 END),0) AS bruto_verlies,
        COALESCE(SUM(COALESCE(fee_eur,0)),0) AS totale_fees,
        COUNT(*) AS n,
        ROUND(AVG(COALESCE(amount_eur,0))::numeric,4) AS gem_inzet
    FROM public.experience_trades
    WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
      AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
      AND COALESCE(exit_time,updated_at) >= NOW() - INTERVAL '1 day' * %s
    """, (days,))

    if not rows:
        return {}

    r = rows[0]
    bruto_winst  = safe_float(r.get("bruto_winst"))
    bruto_verlies = safe_float(r.get("bruto_verlies"))
    fees         = safe_float(r.get("totale_fees"))
    n            = safe_int(r.get("n"))
    gem_inzet    = safe_float(r.get("gem_inzet"))

    # Schat fees als niet bijgehouden
    if fees < 0.001 and gem_inzet > 0:
        fees = n * gem_inzet * 0.005  # 0.5% round trip schatting

    fee_pct_winst = (fees / max(bruto_winst, 0.001)) * 100
    netto_winst   = bruto_winst - bruto_verlies - fees
    gem_fee       = fees / max(n, 1)

    data = {
        "bruto_winst": round(bruto_winst, 4),
        "bruto_verlies": round(bruto_verlies, 4),
        "totale_fees": round(fees, 4),
        "netto_winst": round(netto_winst, 4),
        "fee_pct_winst": round(fee_pct_winst, 1),
        "gem_fee_per_trade": round(gem_fee, 4),
        "n": n,
    }
    sla_geheugen_op(conn, "fees", f"analyse_{days}d", data)
    return data


def format_fee_rapport(data: Dict) -> str:
    if not data:
        return ""
    waarschuwing = " ⚠️ HOOG" if data.get("fee_pct_winst", 0) > 25 else " ✅"
    return (
        f"💰 FEE IMPACT:\n"
        f"• Bruto winst:  €{data.get('bruto_winst',0):.4f}\n"
        f"• Totale fees:  €{data.get('totale_fees',0):.4f} ({data.get('fee_pct_winst',0):.1f}% van winst){waarschuwing}\n"
        f"• Gem. fee/trade: €{data.get('gem_fee_per_trade',0):.4f}\n"
        f"• Netto resultaat: €{data.get('netto_winst',0):.4f}\n\n"
    )


