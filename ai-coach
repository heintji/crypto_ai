# ── ANOMALIE DETECTIE ─────────────────────────────────────────
def detecteer_en_log_anomalieen(conn, totalen: Dict, week_verg: Dict,
                                  fee_data: Dict, r_verd: Dict) -> List[Dict]:
    """
    Detecteert statistische anomalieën in alle metrics.
    Vergelijkt huidige waarden met historische gemiddelden.
    Logt elke anomalie permanent.
    """
    anomalieen: List[Dict] = []

    # Helper: voeg anomalie toe
    def voeg_toe(type_: str, beschrijving: str, waarde: float,
                 drempel: float, ernst: str = "MEDIUM"):
        anomalieen.append({
            "type": type_, "beschrijving": beschrijving,
            "waarde": waarde, "drempel": drempel, "ernst": ernst,
        })
        try:
            with conn.cursor() as cur:
                cur.execute("""
                INSERT INTO public.coach_anomalieen(type, omschrijving, waarde, drempel)
                VALUES(%s, %s, %s, %s)
                """, (type_, beschrijving, waarde, drempel))
            conn.commit()
            log_event(conn, "COACH", "ANOMALIE", beschrijving,
                      {"waarde": waarde, "drempel": drempel}, ernst)
        except Exception:
            pass

    wr   = safe_float(totalen.get("win_rate"))
    pf   = safe_float(totalen.get("profit_factor"))
    n    = safe_int(totalen.get("n"))

    # 1. Win rate anomalie
    if n >= 10 and wr < 35:
        voeg_toe("WIN_RATE_CRASH", f"Win rate {wr:.1f}% — kritiek laag",
                 wr, 35.0, "KRITIEK")
    elif n >= 10 and wr > 85:
        voeg_toe("WIN_RATE_ONREALISTISCH", f"Win rate {wr:.1f}% — verdacht hoog",
                 wr, 85.0, "LAAG")

    # 2. Profit factor anomalie
    if pf > 0 and pf < 0.8:
        voeg_toe("PF_NEGATIEF", f"PF {pf:.2f} — systeem verliest geld",
                 pf, 0.8, "KRITIEK")
    elif pf > 5.0:
        voeg_toe("PF_ONREALISTISCH", f"PF {pf:.2f} — mogelijk data fout",
                 pf, 5.0, "LAAG")

    # 3. Sterke week-over-week daling
    wr_diff = safe_float(week_verg.get("wr_diff"))
    if wr_diff < -15:
        voeg_toe("STERKE_DALING", f"Win rate -15%+ in 1 week ({wr_diff:.1f}%)",
                 wr_diff, -15.0, "HOOG")

    # 4. Fee anomalie
    fee_pct = safe_float(fee_data.get("fee_pct_winst"))
    if fee_pct > 40:
        voeg_toe("HOGE_FEES", f"Fees zijn {fee_pct:.1f}% van winst",
                 fee_pct, 40.0, "HOOG")

    # 5. Expectancy negatief
    expectancy = safe_float(r_verd.get("expectancy"))
    if n >= 10 and expectancy < -0.1:
        voeg_toe("NEGATIEVE_EXPECTANCY", f"Expectancy {expectancy:.3f}R — systeem verliest per trade",
                 expectancy, -0.1, "KRITIEK")

    # 6. Geen trades terwijl bot actief
    laatste_trade = run_query(conn, """
    SELECT MAX(COALESCE(exit_time, updated_at)) AS laatste
    FROM public.experience_trades
    WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
    """)
    if laatste_trade:
        laatste = laatste_trade[0].get("laatste")
        if laatste:
            if isinstance(laatste, str):
                try:
                    from dateutil import parser as dparser
                    laatste = dparser.parse(laatste)
                except Exception:
                    laatste = None
            if laatste:
                try:
                    delta_uren = (now_utc() - laatste.replace(tzinfo=timezone.utc)
                                  if laatste.tzinfo is None else now_utc() - laatste
                                  ).total_seconds() / 3600
                    bot_actief = get_bot_state(conn, "bot_active", "false").lower() == "true"
                    if delta_uren > 72 and bot_actief:
                        voeg_toe("GEEN_TRADES", f"Geen live trades in {delta_uren:.0f}u terwijl bot actief",
                                 delta_uren, 72.0, "HOOG")
                except Exception:
                    pass

    if anomalieen:
        log(f"🔍 {len(anomalieen)} anomalieën gedetecteerd")

    sla_geheugen_op(conn, "anomalieen", "laatste_run", anomalieen)
    return anomalieen


