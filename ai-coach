# ── MAANDELIJKSE TREND ANALYSE ────────────────────────────────
def analyseer_langetermijn_trend(conn) -> Dict:
    """
    Kijkt naar de langetermijn trend over 90 dagen.
    Detecteert of de bot evolueert (beter wordt) of stagnateert.
    """
    rows = run_query(conn, """
    SELECT
        DATE_TRUNC('week', COALESCE(exit_time,updated_at) AT TIME ZONE 'UTC') AS week,
        COUNT(*) AS n,
        ROUND(COUNT(*) FILTER (WHERE UPPER(outcome)='WIN')::numeric/NULLIF(COUNT(*),0)*100,1) AS win_rate,
        ROUND(SUM(CASE WHEN UPPER(outcome)='WIN' THEN ABS(COALESCE(pnl_eur,0))
                       WHEN UPPER(outcome)='LOSS' THEN -ABS(COALESCE(pnl_eur,0)) ELSE 0 END)::numeric,4) AS pnl,
        ROUND(COALESCE(SUM(CASE WHEN UPPER(outcome)='WIN' THEN ABS(COALESCE(pnl_eur,0)) ELSE 0 END),0)
            /NULLIF(SUM(CASE WHEN UPPER(outcome)='LOSS' THEN ABS(COALESCE(pnl_eur,0)) ELSE 0 END),0.001),2) AS pf
    FROM public.experience_trades
    WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
      AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
      AND COALESCE(exit_time,updated_at) >= NOW() - INTERVAL '90 days'
    GROUP BY 1 HAVING COUNT(*) >= 3 ORDER BY 1
    """)

    if len(rows) < 3:
        return {"trend": "ONVOLDOENDE_DATA", "rows": rows}

    # Lineaire trend berekening (win rate)
    wrs = [safe_float(r.get("win_rate")) for r in rows]
    n   = len(wrs)
    x_gem = (n - 1) / 2
    y_gem = sum(wrs) / n

    teller = sum((i - x_gem) * (wrs[i] - y_gem) for i in range(n))
    noemer = sum((i - x_gem) ** 2 for i in range(n))
    helling = teller / noemer if noemer > 0 else 0

    trend = "STIJGEND" if helling > 0.5 else "DALEND" if helling < -0.5 else "STABIEL"

    data = {
        "trend": trend,
        "helling_per_week": round(helling, 2),
        "eerste_wr": wrs[0],
        "laatste_wr": wrs[-1],
        "rows": rows,
    }
    sla_geheugen_op(conn, "langetermijn", "trend_90d", data)
    return data


def format_langetermijn_trend(data: Dict) -> str:
    if not data or data.get("trend") == "ONVOLDOENDE_DATA":
        return ""
    trend = data.get("trend", "?")
    helling = data.get("helling_per_week", 0)
    eerste = data.get("eerste_wr", 0)
    laatste = data.get("laatste_wr", 0)
    emoji = "📈" if trend == "STIJGEND" else "📉" if trend == "DALEND" else "➡️"
    return (
        f"📊 90-DAAGSE TREND: {trend} {emoji}\n"
        f"• Win rate: {eerste:.1f}% → {laatste:.1f}% ({helling:+.2f}%/week)\n\n"
    )


# ── OPEN POSITIES REAL-TIME CHECK ─────────────────────────────
def check_open_posities_realtime(conn) -> Dict:
    """
    Combineert DB open trades met live Bitvavo posities.
    Detecteert discrepanties: trades in DB maar niet op exchange, of vice versa.
    """
    try:
        # DB open trades
        db_open = run_query(conn, """
        SELECT coin, COALESCE(entry_price, buy_price) AS entry_prijs,
               COALESCE(amount_eur, position_eur) AS inzet,
               COALESCE(entry_time, created_at) AS open_sinds
        FROM public.experience_trades
        WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
          AND UPPER(COALESCE(outcome,'OPEN')) NOT IN ('WIN','LOSS','CANCELLED')
        ORDER BY open_sinds
        """)

        # Live Bitvavo balances
        bitvavo_bals = get_bitvavo_balances()
        bitvavo_coins = {k for k, v in bitvavo_bals.items()
                         if v > 0.001 and k != "EUR"}

        db_coins = {safe_str(r.get("coin", "")).replace("-EUR", "")
                    for r in db_open}

        alleen_bitvavo = bitvavo_coins - db_coins
        alleen_db      = db_coins - bitvavo_coins - {""}

        discrepanties = []
        if alleen_bitvavo:
            discrepanties.append(f"Op Bitvavo maar NIET in DB: {', '.join(alleen_bitvavo)}")
        if alleen_db:
            discrepanties.append(f"In DB maar NIET op Bitvavo: {', '.join(alleen_db)}")

        # Live prijzen ophalen voor floating P&L
        prijzen = get_bitvavo_ticker_prices()
        posities_details = []
        for r in db_open:
            coin     = safe_str(r.get("coin", ""))
            entry    = safe_float(r.get("entry_prijs"))
            inzet    = safe_float(r.get("inzet"))
            prijs_key = f"{coin.replace('-EUR','')}-EUR"
            live_prijs = prijzen.get(prijs_key, 0)

            if entry > 0 and live_prijs > 0:
                pnl_pct = (live_prijs - entry) / entry * 100
                floating_eur = inzet * (pnl_pct / 100)
            else:
                pnl_pct = 0
                floating_eur = 0

            posities_details.append({
                "coin": coin,
                "entry": entry,
                "live": live_prijs,
                "pnl_pct": round(pnl_pct, 2),
                "floating_eur": round(floating_eur, 4),
            })

        totaal_floating = sum(p["floating_eur"] for p in posities_details)

        data = {
            "n_open": len(db_open),
            "discrepanties": discrepanties,
            "posities": posities_details,
            "totaal_floating_eur": round(totaal_floating, 4),
        }
        sla_geheugen_op(conn, "open_posities", "realtime", data)
        return data

    except Exception as e:
        log(f"⚠️ Open posities check: {e}")
        return {"n_open": 0, "discrepanties": [], "posities": [], "totaal_floating_eur": 0}


def format_open_posities_realtime(data: Dict) -> str:
    if not data:
        return ""
    n = data.get("n_open", 0)
    floating = data.get("totaal_floating_eur", 0)
    s = "+" if floating >= 0 else ""
    r = f"📂 OPEN POSITIES: {n} | Floating: {s}€{floating:.4f}\n"
    for p in data.get("posities", [])[:5]:
        pnl = safe_float(p.get("pnl_pct"))
        emoji = "🟢" if pnl > 0 else "🔴"
        r += (f"  {emoji} {p.get('coin','?')}: "
              f"entry €{p.get('entry',0):.4f} → live €{p.get('live',0):.4f} "
              f"({pnl:+.1f}%)\n")
    if data.get("discrepanties"):
        r += "⚠️ DISCREPANTIES:\n"
        for d in data["discrepanties"]:
            r += f"  → {d}\n"
    r += "\n"
    return r


# ── VOLLEDIG GEHEUGEN SAMENVATTING VOOR CLAUDE ───────────────
def bouw_geheugen_context_voor_claude(conn) -> str:
    """
    Bouwt een compacte samenvatting van het coach geheugen voor Claude.
    Zodat Claude bij de finale analyse alle historische context heeft.
    """
    geheugen = haal_volledig_geheugen_op(conn)

    context_delen = []

    # Recente configuratie wijzigingen
    wijzigingen = get_recente_config_wijzigingen(conn, 168)  # 7 dagen
    if wijzigingen:
        context_delen.append(
            f"Config wijzigingen (7d): " +
            ", ".join(f"{w.get('parameter')}:{w.get('oud_waarde')}→{w.get('nieuw_waarde')}"
                      for w in wijzigingen[:5])
        )

    # Regime history
    regime_hist = get_regime_overgang_history(conn, 30)
    if regime_hist:
        context_delen.append(
            f"Regime overgangen (30d): " +
            ", ".join(f"{r.get('oud_regime')}→{r.get('nieuw_regime')}"
                      for r in regime_hist[:3])
        )

    # Vorige coach beslissingen
    vorige_analyses = run_query(conn, """
    SELECT run_datum, aanpassingen, claude_advies FROM public.coach_analyses
    ORDER BY run_datum DESC LIMIT 3
    """)
    if vorige_analyses:
        for a in vorige_analyses:
            datum = safe_str(a.get("run_datum", ""))[:10]
            aanp  = safe_str(a.get("aanpassingen", ""))[:100]
            if aanp:
                context_delen.append(f"Vorige run {datum}: {aanp}")

    # Recente anomalieën
    anom = run_query(conn, """
    SELECT type, omschrijving FROM public.coach_anomalieen
    WHERE tijdstip >= NOW() - INTERVAL '7 days'
      AND opgelost = FALSE ORDER BY tijdstip DESC LIMIT 5
    """)
    if anom:
        context_delen.append(
            "Openstaande anomalieën: " +
            ", ".join(safe_str(a.get("type")) for a in anom)
        )

    # Dagboek samenvatting
    dagboek = get_dagboek_history(conn, 3)
    if dagboek:
        for d in dagboek[:2]:
            datum = safe_str(d.get("datum", ""))
            sam   = safe_str(d.get("samenvatting", ""))[:80]
            context_delen.append(f"Coach {datum}: {sam}")

    return "\n".join(context_delen) if context_delen else "Geen geheugen beschikbaar"


