# FEATURE 18: COIN PERFORMANCE RANKING
# ============================================================
def bereken_coin_ranking(conn, days: int) -> Dict:
    """
    Uitgebreide coin ranking op basis van meerdere factoren:
    win rate, profit factor, consistentie, recente trend.
    """
    rows = run_query(conn, """
    SELECT
        COALESCE(coin,'?') AS coin,
        COUNT(*) AS n,
        COUNT(*) FILTER (WHERE UPPER(outcome)='WIN') AS wins,
        ROUND(COUNT(*) FILTER (WHERE UPPER(outcome)='WIN')::numeric/NULLIF(COUNT(*),0)*100,1) AS win_rate,
        ROUND(SUM(CASE WHEN UPPER(outcome)='WIN' THEN ABS(COALESCE(pnl_eur,0))
                       WHEN UPPER(outcome)='LOSS' THEN -ABS(COALESCE(pnl_eur,0)) ELSE 0 END)::numeric,4) AS total_pnl,
        ROUND(COALESCE(SUM(CASE WHEN UPPER(outcome)='WIN' THEN ABS(COALESCE(pnl_eur,0)) ELSE 0 END),0)
            /NULLIF(SUM(CASE WHEN UPPER(outcome)='LOSS' THEN ABS(COALESCE(pnl_eur,0)) ELSE 0 END),0.001),2) AS profit_factor,
        ROUND(AVG(COALESCE(pnl_r,result_r,0))::numeric,2) AS avg_r,
        ROUND(STDDEV(COALESCE(pnl_r,result_r,0))::numeric,2) AS stddev_r
    FROM public.experience_trades
    WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
      AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
      AND COALESCE(exit_time,updated_at) >= NOW() - INTERVAL '1 day' * %s
    GROUP BY 1 HAVING COUNT(*) >= 5
    ORDER BY total_pnl DESC
    """, (days,))

    # Bereken composite score per coin
    gerankt = []
    for r in rows:
        wr  = safe_float(r.get("win_rate"))
        pf  = safe_float(r.get("profit_factor"))
        pnl = safe_float(r.get("total_pnl"))
        std = safe_float(r.get("stddev_r"), 1.0)

        # Composite score: win rate + profit factor + consistentie
        consistentie = max(0, 1 - std / 2)
        composite = (wr / 100 * 40) + (min(pf, 3) / 3 * 40) + (consistentie * 20)

        gerankt.append({
            **r,
            "composite_score": round(composite, 1),
            "consistentie": round(consistentie * 100, 1),
        })

    gerankt.sort(key=lambda x: x["composite_score"], reverse=True)

    # Top 5 en bottom 5
    top5    = gerankt[:5]
    bottom5 = gerankt[-5:] if len(gerankt) > 5 else []

    sla_geheugen_op(conn, "coin_ranking", f"top5_{days}d", [c["coin"] for c in top5])
    sla_geheugen_op(conn, "coin_ranking", f"bottom5_{days}d", [c["coin"] for c in bottom5])

    return {"top5": top5, "bottom5": bottom5, "totaal": len(gerankt)}


def format_coin_ranking(data: Dict) -> str:
    if not data:
        return ""
    r = "🏆 COIN RANKING (composite score):\n"
    r += "  TOP:\n"
    for c in data.get("top5", [])[:3]:
        r += (
            f"  • {safe_str(c.get('coin'))}: "
            f"score={c.get('composite_score',0):.0f} | "
            f"WR={safe_float(c.get('win_rate')):.1f}% | "
            f"PF={safe_float(c.get('profit_factor')):.2f} | "
            f"PnL=€{safe_float(c.get('total_pnl')):.4f}\n"
