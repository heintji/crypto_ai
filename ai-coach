def update_coin_rotatie(conn, coin_data: List[Dict]) -> Dict:
    """Auto bijwerken whitelist en blacklist op basis van data."""
    huidige_bl = haal_geheugen_op(conn, "blacklist", "coins") or []
    huidige_wl = haal_geheugen_op(conn, "whitelist", "coins") or []

    bl_nieuw = []
    wl_nieuw = []
    bl_weg   = []

    for r in coin_data:
        coin = safe_str(r.get("coin"))
        n    = safe_int(r.get("n"))
        wr   = safe_float(r.get("win_rate"))

        if n < BLACKLIST_MIN_TRADES:
            continue

        if wr < BLACKLIST_MAX_WR * 100 and coin not in huidige_bl:
            huidige_bl.append(coin)
            bl_nieuw.append(coin)
        elif wr >= 65 and coin not in huidige_wl:
            huidige_wl.append(coin)
            wl_nieuw.append(coin)

        # Rehabiliteer verbeterde coins
        if wr >= 45 and coin in huidige_bl:
            huidige_bl.remove(coin)
            bl_weg.append(coin)

    sla_geheugen_op(conn, "blacklist", "coins", huidige_bl)
    sla_geheugen_op(conn, "whitelist", "coins", huidige_wl)
    set_bot_state(conn, "coach_blacklist", json.dumps(huidige_bl[:50]))
    set_bot_state(conn, "coach_whitelist", json.dumps(huidige_wl[:50]))

    if bl_nieuw:
        log(f"⚫ Blacklist +{len(bl_nieuw)}: {bl_nieuw[:3]}")
    if wl_nieuw:
        log(f"⭐ Whitelist +{len(wl_nieuw)}: {wl_nieuw[:3]}")

    return {"bl_nieuw": bl_nieuw, "wl_nieuw": wl_nieuw, "bl_weg": bl_weg,
            "bl_totaal": len(huidige_bl), "wl_totaal": len(huidige_wl)}


