def analyseer_pending_approvals(conn) -> Dict:
    """
    Analyseert de pending approvals tabel.
    Hoeveel signalen wachten, verlopen, uitgevoerd?
    """
    try:
        rows = run_query(conn, """
        SELECT
            COALESCE(status,'PENDING') AS status,
            COUNT(*) AS n,
            ROUND(AVG(COALESCE(score,0))::numeric,1) AS gem_score,
            MIN(created_at) AS oudste,
            MAX(created_at) AS nieuwste
        FROM public.pending_approvals
        GROUP BY 1
        """)

        # Verlopen pending signalen van vandaag
        verlopen_vandaag = run_scalar(conn, """
        SELECT COUNT(*) FROM public.pending_approvals
        WHERE expires_at < NOW()
          AND DATE(created_at AT TIME ZONE 'UTC') = CURRENT_DATE
          AND COALESCE(status,'PENDING') = 'PENDING'
        """, default=0)

        # Hoeveel uitgevoerd vs verlopen ratio
        uitgevoerd = run_scalar(conn, """
        SELECT COUNT(*) FROM public.pending_approvals
        WHERE COALESCE(status,'PENDING') IN ('CONSUMED','EXECUTED')
          AND COALESCE(exit_time, updated_at, created_at) >= NOW() - INTERVAL '7 days'
        """, default=0)

        totaal_7d = run_scalar(conn, """
        SELECT COUNT(*) FROM public.pending_approvals
        WHERE COALESCE(exit_time, updated_at, created_at) >= NOW() - INTERVAL '7 days'
        """, default=0)

        executie_ratio = (safe_int(uitgevoerd) / max(safe_int(totaal_7d), 1)) * 100

        return {
            "per_status": {safe_str(r.get("status")): safe_int(r.get("n")) for r in rows},
            "gem_score": safe_float(rows[0].get("gem_score")) if rows else 0,
            "verlopen_vandaag": safe_int(verlopen_vandaag),
            "executie_ratio_7d": round(executie_ratio, 1),
        }
    except Exception as e:
        log(f"⚠️ Pending approvals analyse: {e}")
        return {}


