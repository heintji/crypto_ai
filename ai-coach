def _claude_analyse(prompt: str, max_tokens: int = 500) -> str:
    """
    Roept Claude API aan voor diepgaande analyse.
    Identieke implementatie in alle bestanden.
    Hogere max_tokens voor AI Coach — geeft meer detail.
    """
    if not ANTHROPIC_API_KEY:
        log("⚠️ ANTHROPIC_API_KEY niet ingesteld — geen Claude analyse")
        return ""
    try:
        resp = requests.post(
            "https://api.anthropic.com/v1/messages",
            headers={
                "x-api-key":         ANTHROPIC_API_KEY,
                "anthropic-version": "2023-06-01",
                "content-type":      "application/json",
            },
            json={
                "model":      "claude-sonnet-4-20250514",
                "max_tokens": max_tokens,
                "messages":   [{"role": "user", "content": prompt}],
            },
            timeout=30,
        )
        if resp.status_code == 200:
            content = resp.json().get("content", [])
            if content:
                return content[0]["text"].strip()
        log(f"⚠️ Claude API status {resp.status_code}")
        return ""
    except Exception as e:
        log(f"⚠️ Claude API fout: {type(e).__name__}: {e}")
        return ""


