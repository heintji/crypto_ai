        for k in kansen[:5]:
            match = "✅" if k["regime_match"] else "➡️"
            r += f"• {k['setup']}/{k['regime']}: {k['verwachte_wr']:.1f}% WR | R:{k['verwachte_r']:.2f} | {k['prioriteit']} {match}\n"
        r += "\n"

    if patroon["beste_uren"]:
        r += "⏰ BESTE UREN: " + ", ".join(f"{u['uur']:02d}:00 ({u['wr']:.0f}%)" for u in patroon["beste_uren"][:4]) + "\n"
    if patroon["slechte_uren"]:
        r += "⛔ SLECHTE UREN: " + ", ".join(f"{u['uur']:02d}:00 ({u['wr']:.0f}%)" for u in patroon["slechte_uren"][:3]) + "\n"
    if patroon["beste_dagen"]:
        r += "📅 BESTE DAGEN: " + ", ".join(f"{d['dag']} ({d['wr']:.0f}%)" for d in patroon["beste_dagen"]) + "\n"
    r += "\n"

    r += (
        f"🪙 COIN ROTATIE:\n"
        f"• Blacklist: {coin_rot['bl_totaal']} | Whitelist: {coin_rot['wl_totaal']}\n"
    )
    if coin_rot["bl_nieuw"]:
        r += f"• Nieuw geblokkeerd: {', '.join(coin_rot['bl_nieuw'][:3])}\n"
    if coin_rot["wl_nieuw"]:
        r += f"• Nieuwe topper: {', '.join(coin_rot['wl_nieuw'][:3])}\n"
    r += "\n"

    if stop_advies["actie"] != "OK":
        r += (
            f"🛑 STOP LOSS: {stop_advies['actie']}\n"
            f"• ATR: {stop_advies['huidig']:.1f} → {stop_advies['aanbeveling']:.1f}\n"
            f"• {stop_advies['reden']}\n\n"
        )

    ed_st = "⚠️" if (swr - lwr) > EDGE_DECAY_DREMPEL else "✅"
    r += f"⚡ EDGE DECAY: Sim {swr:.1f}% vs Live {lwr:.1f}% {ed_st}\n\n"
    r += f"📈 PF TREND: {pf_trend.get('trend','?')} ({pf_trend.get('eerste_helft',0):.2f} → {pf_trend.get('tweede_helft',0):.2f})\n\n"

    # Automatische aanpassingen bepalen
    auto_aanp = []
    if abs(score_advies["verschil"]) > 0:
        auto_aanp.append({"key": "min_score_to_trade",
                          "value": str(score_advies["aanbeveling"]),
                          "reden": score_advies["reden"]})
    if stop_advies["actie"] != "OK":
        auto_aanp.append({"key": "atr_multiplier",
                          "value": str(stop_advies["aanbeveling"]),
                          "reden": stop_advies["reden"]})
    if patroon["aanbeveling_start"] != TRADING_HOURS_START:
        auto_aanp.append({"key": "trading_hours_start",
                          "value": str(patroon["aanbeveling_start"]),
                          "reden": "Patroon: latere start beter"})
    if patroon["aanbeveling_end"] != TRADING_HOURS_END:
        auto_aanp.append({"key": "trading_hours_end",
                          "value": str(patroon["aanbeveling_end"]),
                          "reden": "Patroon: eerder stoppen beter"})

    toegepast = pas_parameters_aan(conn, auto_aanp)

    if toegepast:
        r += f"{'─'*34}\n🔧 AUTO AANPASSINGEN ({len(toegepast)}):\n"
        for a in toegepast:
            r += f"✅ {a}\n"
        r += "\n"

    log("Claude finale beoordeling...")
    claude_txt = claude_finale(totalen, setup_data, score_advies, stop_advies,
                               patroon, kansen, edge_decay, pf_trend,
                               toegepast, regime_vsp, dagen)
    if claude_txt:
        r += f"{'─'*34}\n🧠 CLAUDE:\n{claude_txt}\n\n"

    r += f"{'─'*34}\n🤖 BOT LOOPT DOOR\nCommands: STATUS | STOP | HEALTH"

    kansen_lijst = [f"{k['setup']}/{k['regime']} ({k['verwachte_wr']:.1f}% WR)" for k in kansen[:5]]
    return r, toegepast, kansen_lijst


