    except Exception as e:
        check("database", False, f"DB fout: {e}", "KRITIEK", 30)

    # 2. Vereiste tabellen aanwezig
    vereiste_tabellen = [
        "experience_trades", "pending_approvals", "bot_state",
        "market_regime", "btc_regime_4h", "candles",
