# WHATSAPP
# ============================================================
def send_whatsapp(message: str) -> bool:
    if not all([TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN,
                TWILIO_WHATSAPP_FROM, TWILIO_WHATSAPP_TO]):
        log(f"WhatsApp (geen Twilio): {message[:80]}")
        return False

    MAX_LEN = 1550
    chunks = []
    if len(message) <= MAX_LEN:
        chunks = [message]
    else:
        lines = message.split("\n")
        current = ""
        for line in lines:
            if len(current) + len(line) + 1 > MAX_LEN:
                if current:
                    chunks.append(current.strip())
                current = line + "\n"
            else:
                current += line + "\n"
        if current.strip():
            chunks.append(current.strip())

    success = True
    for i, chunk in enumerate(chunks):
        prefix = f"[{i+1}/{len(chunks)}] " if len(chunks) > 1 else ""
        try:
            resp = requests.post(
                f"https://api.twilio.com/2010-04-01/Accounts/{TWILIO_ACCOUNT_SID}/Messages.json",
                auth=(TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN),
                data={"From": TWILIO_WHATSAPP_FROM, "To": TWILIO_WHATSAPP_TO,
                      "Body": prefix + chunk},
                timeout=15,
            )
            if resp.status_code not in (200, 201):
                success = False
        except Exception as e:
            log(f"❌ WhatsApp: {e}")
            success = False
    return success


def stuur_alert(titel: str, probleem: str, actie: str) -> None:
    """Kort WhatsApp alert bij problemen."""
    send_whatsapp(
        f"⚠️ AI COACH ALERT\n{'─'*28}\n\n"
        f"🔴 {titel}\n\n"
