def get_setup_performance(conn, days: int) -> List[Dict]:
    return run_query(conn, """
    SELECT COALESCE(setup_type,'UNKNOWN') AS setup,
        COUNT(*) AS n,
        COUNT(*) FILTER (WHERE UPPER(outcome)='WIN') AS wins,
        COUNT(*) FILTER (WHERE UPPER(outcome)='LOSS') AS losses,
        ROUND(COUNT(*) FILTER (WHERE UPPER(outcome)='WIN')::numeric/NULLIF(COUNT(*),0)*100,1) AS win_rate,
        ROUND(AVG(COALESCE(pnl_eur,0))::numeric,4) AS avg_pnl,
        ROUND(AVG(COALESCE(pnl_r,result_r,0))::numeric,2) AS avg_r,
        ROUND(COALESCE(SUM(CASE WHEN UPPER(outcome)='WIN' THEN ABS(COALESCE(pnl_eur,0)) ELSE 0 END),0)
            /NULLIF(SUM(CASE WHEN UPPER(outcome)='LOSS' THEN ABS(COALESCE(pnl_eur,0)) ELSE 0 END),0.001),2) AS profit_factor
    FROM public.experience_trades
    WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
      AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
      AND COALESCE(exit_time,updated_at) >= NOW() - INTERVAL '1 day' * %s
    GROUP BY 1 HAVING COUNT(*) >= %s ORDER BY win_rate DESC
    """, (days, MIN_TRADES_FOR_ANALYSE))


def get_score_range_performance(conn, days: int) -> List[Dict]:
    return run_query(conn, """
    SELECT
        CASE WHEN COALESCE(score,0) BETWEEN 80 AND 84 THEN '80-84'
             WHEN COALESCE(score,0) BETWEEN 85 AND 89 THEN '85-89'
             WHEN COALESCE(score,0) BETWEEN 90 AND 94 THEN '90-94'
             WHEN COALESCE(score,0) >= 95 THEN '95+'
             ELSE '<80' END AS score_range,
        COUNT(*) AS n,
        ROUND(COUNT(*) FILTER (WHERE UPPER(outcome)='WIN')::numeric/NULLIF(COUNT(*),0)*100,1) AS win_rate,
        ROUND(AVG(COALESCE(pnl_eur,0))::numeric,4) AS avg_pnl
    FROM public.experience_trades
    WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
      AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
      AND COALESCE(exit_time,updated_at) >= NOW() - INTERVAL '1 day' * %s
    GROUP BY 1 HAVING COUNT(*) >= 5 ORDER BY score_range
    """, (days,))


