# FEATURE 7: NIEUWE TRADE KANSEN DETECTEREN
# ============================================================
def detecteer_kansen(conn) -> List[Dict]:
    """
    Zoekt naar beste setup/regime combinaties op basis van historische data.
    Slaat kansen op in coach_kansen tabel voor dashboard.
    """
    kansen = []
    try:
        beste_combos = run_query(conn, """
        SELECT COALESCE(setup_type,'UNKNOWN') AS setup,
            COALESCE(market_regime,regime,'UNKNOWN') AS regime,
            COUNT(*) AS n,
            ROUND(COUNT(*) FILTER (WHERE UPPER(outcome)='WIN')::numeric/NULLIF(COUNT(*),0)*100,1) AS win_rate,
            ROUND(AVG(COALESCE(pnl_r,result_r,0))::numeric,2) AS avg_r
        FROM public.experience_trades
        WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE','SIM')
          AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
          AND COALESCE(exit_time,updated_at) >= NOW() - INTERVAL '90 days'
        GROUP BY 1,2
        HAVING COUNT(*) >= 10
          AND COUNT(*) FILTER (WHERE UPPER(outcome)='WIN')::numeric/NULLIF(COUNT(*),0) >= 0.60
        ORDER BY win_rate DESC LIMIT 10
        """)

        btc_row = run_query(conn, "SELECT regime FROM public.btc_regime_4h ORDER BY open_time DESC LIMIT 1")
        huidig_regime = safe_str(btc_row[0].get("regime"), "UNKNOWN") if btc_row else "UNKNOWN"

        for c in beste_combos:
            setup  = safe_str(c.get("setup"))
            regime = safe_str(c.get("regime"))
            wr     = safe_float(c.get("win_rate"))
            avg_r  = safe_float(c.get("avg_r"))
            n      = safe_int(c.get("n"))
            match  = (regime == huidig_regime or regime == "UNKNOWN")

            kans = {
                "setup": setup, "regime": regime,
                "huidig_regime": huidig_regime, "regime_match": match,
                "verwachte_wr": wr, "verwachte_r": avg_r, "n_trades": n,
                "prioriteit": "HOOG" if (wr >= 65 and match) else "MIDDEL",
            }
            kansen.append(kans)

            try:
                with conn.cursor() as cur:
                    cur.execute("""
                    INSERT INTO public.coach_kansen(setup_type, regime, reden, verwachte_wr, geldig_tot)
                    VALUES(%s, %s, %s, %s, NOW() + INTERVAL '15 days')
                    ON CONFLICT DO NOTHING
                    """, (setup, regime, f"WR={wr:.1f}% ({n} trades), R={avg_r:.2f}", wr/100))
                conn.commit()
            except Exception:
                conn.rollback()

        log(f"🎯 {len(kansen)} kansen gedetecteerd")
    except Exception as e:
        log(f"⚠️ Kansen detectie: {e}")
    return kansen


