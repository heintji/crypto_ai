    """
    Profit factor per week over de laatste 8 weken.
    Toont of het systeem beter of slechter presteert in de tijd.
    """
    return run_query(conn, """
    SELECT
        DATE_TRUNC('week', COALESCE(exit_time, updated_at) AT TIME ZONE 'UTC') AS week_start,
        COUNT(*) AS n,
        ROUND(
            COALESCE(SUM(CASE WHEN UPPER(outcome)='WIN' THEN ABS(COALESCE(pnl_eur,0)) ELSE 0 END), 0)
            / NULLIF(SUM(CASE WHEN UPPER(outcome)='LOSS' THEN ABS(COALESCE(pnl_eur,0)) ELSE 0 END), 0.001),
        2) AS profit_factor,
        ROUND(
            COUNT(*) FILTER (WHERE UPPER(outcome)='WIN')::numeric
            / NULLIF(COUNT(*),0) * 100, 1
        ) AS win_rate
    FROM public.experience_trades
    WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
      AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
      AND COALESCE(exit_time, updated_at) >= NOW() - INTERVAL '8 weeks'
    GROUP BY 1
    HAVING COUNT(*) >= 3
    ORDER BY 1 ASC
    """)


def get_totale_statistieken(conn, days: int = 60) -> Dict[str, Any]:
    """Algemene statistieken over de analyseperiode."""
    rows = run_query(conn, """
    SELECT
        COUNT(*) AS n,
        COUNT(*) FILTER (WHERE UPPER(outcome)='WIN') AS wins,
        COUNT(*) FILTER (WHERE UPPER(outcome)='LOSS') AS losses,
        ROUND(
            COUNT(*) FILTER (WHERE UPPER(outcome)='WIN')::numeric
            / NULLIF(COUNT(*),0) * 100, 1
        ) AS win_rate,
        ROUND(SUM(CASE
            WHEN UPPER(outcome)='WIN'  THEN  ABS(COALESCE(pnl_eur,0))
            WHEN UPPER(outcome)='LOSS' THEN -ABS(COALESCE(pnl_eur,0))
            ELSE 0 END)::numeric, 4) AS net_pnl,
        ROUND(AVG(COALESCE(pnl_r, result_r, 0))::numeric, 3) AS avg_r,
        ROUND(
            COALESCE(SUM(CASE WHEN UPPER(outcome)='WIN' THEN ABS(COALESCE(pnl_eur,0)) ELSE 0 END), 0)
            / NULLIF(SUM(CASE WHEN UPPER(outcome)='LOSS' THEN ABS(COALESCE(pnl_eur,0)) ELSE 0 END), 0.001),
        2) AS profit_factor
    FROM public.experience_trades
    WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
      AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
      AND COALESCE(exit_time, updated_at) >= NOW() - INTERVAL '1 day' * %s
    """, (days,))

    return dict(rows[0]) if rows else {}


