# ── BESTAND CHECKSUM MONITOR ─────────────────────────────────
def monitor_bestand_wijzigingen(conn) -> Dict:
    """
    Controleert of Python bestanden gewijzigd zijn.
    Detecteert deploys en code updates automatisch.
    Slaat checksum + regelaantal op per bestand.
    """
    import hashlib

    bestanden = [
        "trade_monitor.py",
        "whatsapp_webhook.py",
        "ai_coach.py",
        "analysis/multi_coin_score.py",
        "dashboard/app.py",
        "requirements.txt",
    ]

    wijzigingen: List[Dict] = []

    for bestand in bestanden:
        # Zoek bestand op meerdere locaties
        paden = [
            f"/app/{bestand}",
            f"/home/claude/{bestand}",
            f"./{bestand}",
            bestand,
        ]
        pad = None
        for p in paden:
            import os
            if os.path.isfile(p):
                pad = p
                break

        if not pad:
            continue

        try:
            with open(pad, "rb") as f:
                inhoud = f.read()

            checksum  = hashlib.sha256(inhoud).hexdigest()[:16]
            regelaantal = inhoud.decode("utf-8", errors="ignore").count("\n")

            # Vergelijk met opgeslagen checksum
            oud_rows = run_query(conn, """
            SELECT checksum, regels FROM public.coach_bestand_checksums
            WHERE bestandsnaam = %s
            """, (bestand,))

            veranderd = False
            if oud_rows:
                oud_checksum = safe_str(oud_rows[0].get("checksum"))
                oud_regels   = safe_int(oud_rows[0].get("regels"))
                if oud_checksum != checksum:
                    veranderd = True
                    delta_regels = regelaantal - oud_regels
                    wijzigingen.append({
                        "bestand": bestand,
                        "oud_checksum": oud_checksum,
                        "nieuw_checksum": checksum,
                        "delta_regels": delta_regels,
                        "regels": regelaantal,
                    })
                    log(f"📝 Bestand gewijzigd: {bestand} ({delta_regels:+d} regels)")
                    log_event(conn, "BOT", "BESTAND_GEWIJZIGD",
                              f"{bestand}: {delta_regels:+d} regels", {"checksum": checksum})

            # Upsert checksum
            with conn.cursor() as cur:
                cur.execute("""
                INSERT INTO public.coach_bestand_checksums(bestandsnaam, checksum, regels, bijgewerkt, verandering_gedetecteerd)
                VALUES(%s, %s, %s, NOW(), %s)
                ON CONFLICT(bestandsnaam) DO UPDATE
                    SET checksum=EXCLUDED.checksum, regels=EXCLUDED.regels,
                        bijgewerkt=NOW(), verandering_gedetecteerd=EXCLUDED.verandering_gedetecteerd
                """, (bestand, checksum, regelaantal, veranderd))
            conn.commit()

        except Exception as e:
            log(f"⚠️ Checksum {bestand}: {e}")

    return {"gewijzigd": wijzigingen, "n": len(wijzigingen)}


