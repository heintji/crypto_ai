def analyseer_score_drempel(score_data: List[Dict]) -> Dict:
    if not score_data:
        return {"aanbeveling": MIN_SCORE_TO_TRADE, "reden": "Geen data", "verschil": 0}
    beste_range = None
    beste_wr    = 0.0
    for r in score_data:
        wr  = safe_float(r.get("win_rate"))
        rng = safe_str(r.get("score_range"))
        n   = safe_int(r.get("n"))
        if wr > beste_wr and n >= MIN_TRADES_FOR_ANALYSE:
            beste_wr = wr
            beste_range = rng
    drempel_map = {"80-84": 80, "85-89": 85, "90-94": 90, "95+": 95}
    nieuwe = drempel_map.get(beste_range, MIN_SCORE_TO_TRADE)
    return {"huidig": MIN_SCORE_TO_TRADE, "aanbeveling": nieuwe,
            "verschil": nieuwe - MIN_SCORE_TO_TRADE,
            "beste_wr": beste_wr, "reden": f"Score {beste_range} → {beste_wr:.1f}% WR"}


def analyseer_stop_loss(mae_data: Dict) -> Dict:
    if not mae_data:
        return {"aanbeveling": ATR_MULTIPLIER, "actie": "OK", "reden": "Geen data"}
    gem_mae = safe_float(mae_data.get("gem_mae"))
    huidig  = ATR_MULTIPLIER
    if gem_mae > 0.75:
        return {"huidig": huidig, "aanbeveling": round(huidig+0.3,1),
                "actie": "VERHOOG", "reden": f"MAE={gem_mae:.2f}R te krap", "gem_mae": gem_mae}
    elif gem_mae < 0.25:
        return {"huidig": huidig, "aanbeveling": round(huidig-0.2,1),
                "actie": "VERLAAG", "reden": f"MAE={gem_mae:.2f}R te wijd", "gem_mae": gem_mae}
    return {"huidig": huidig, "aanbeveling": huidig,
            "actie": "OK", "reden": f"MAE={gem_mae:.2f}R adequaat", "gem_mae": gem_mae}


def analyseer_pf_trend(pf_data: List[Dict]) -> Dict:
    if len(pf_data) < 4:
        return {"trend": "onbekend", "actie": "meer data", "alle_waarden": [],
                "eerste_helft": 0.0, "tweede_helft": 0.0}
    pfs    = [safe_float(r.get("profit_factor")) for r in pf_data]
    eerste = sum(pfs[:len(pfs)//2]) / max(len(pfs)//2, 1)
    tweede = sum(pfs[len(pfs)//2:]) / max(len(pfs)-len(pfs)//2, 1)
    v      = tweede - eerste
    trend  = "verbeterend" if v > 0.2 else "verslechterend" if v < -0.3 else "stabiel"
    return {"trend": trend, "actie": "doorgaan" if trend != "verslechterend" else "aanpassing nodig",
            "eerste_helft": round(eerste,2), "tweede_helft": round(tweede,2),
            "verandering": round(v,2), "alle_waarden": [round(p,2) for p in pfs]}


