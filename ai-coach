        vorige_aanpassingen = json.loads(aanp_json)
    except Exception:
        pass

    # Detecteer conflicten
    conflicten = []
    if huidig["trading_start"] >= huidig["trading_end"]:
        conflicten.append(f"Trading hours conflict: start {huidig['trading_start']} >= end {huidig['trading_end']}")
    if huidig["min_score"] < 80:
        conflicten.append(f"MIN_SCORE te laag: {huidig['min_score']} — kwaliteit te laag")
    if huidig["max_per_trade"] > 2.0:
        conflicten.append(f"MAX_PER_TRADE hoog: €{huidig['max_per_trade']:.2f} — verhoog risico")

    return {
        "huidig": huidig,
        "conflicten": conflicten,
        "vorige_aanpassingen": vorige_aanpassingen,
        "alle_state_keys": list(state.keys()),
    }


