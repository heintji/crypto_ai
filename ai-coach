def genereer_scanner_suggesties(conn, kansen: List[Dict], setup_gew: Dict,
                                 regime_vsp: Dict) -> List[str]:
    """
    Genereert concrete suggesties voor de scanner op basis van alle analyse.
    Deze worden opgeslagen zodat de scanner ze bij de volgende run kan gebruiken.
    """
    suggesties = []
    huidig_regime = regime_vsp.get("huidig", "UNKNOWN")
    verwacht_regime = regime_vsp.get("voorspelling", huidig_regime)

    # Top kans voor huidig regime
    top_kansen = [k for k in kansen if k.get("regime_match") and k.get("prioriteit") == "HOOG"]
    if top_kansen:
        beste = top_kansen[0]
        suggesties.append(
            f"FOCUS op {beste['setup']} setups in {beste['regime']} regime "
            f"({beste['verwachte_wr']:.1f}% historische WR)"
        )

    # Setup met hoogste gewicht
    if setup_gew:
        beste_setup = max(setup_gew, key=setup_gew.get)
        if setup_gew[beste_setup] >= 1.3:
            suggesties.append(f"PRIORITEER {beste_setup} (gewicht: {setup_gew[beste_setup]:.1f})")

    # Regime overgang verwacht
    if huidig_regime != verwacht_regime:
        suggesties.append(
            f"OPGELET: regime overgang verwacht {huidig_regime} → {verwacht_regime}. "
            f"Wees voorzichtiger met nieuwe trades."
        )

    # Sla op zodat scanner het kan lezen
    set_bot_state(conn, "coach_scanner_suggesties", json.dumps(suggesties[:5], ensure_ascii=False))
    sla_geheugen_op(conn, "scanner", "suggesties", suggesties)

    return suggesties


