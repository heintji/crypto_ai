# FEATURE 9: SCORE CORRELATIE ANALYSE
# ============================================================
def analyseer_score_correlatie(conn, days: int) -> Dict:
    """
    Analyseert de correlatie tussen score en uitkomst.
    Hoge score moet leiden tot meer wins — anders klopt het scoremodel niet.
    Detecteert ook of bepaalde score ranges overperformen.
    """
    rows = run_query(conn, """
    SELECT
        CASE
            WHEN COALESCE(score,0) >= 95 THEN '95+'
            WHEN COALESCE(score,0) >= 90 THEN '90-94'
            WHEN COALESCE(score,0) >= 85 THEN '85-89'
            WHEN COALESCE(score,0) >= 80 THEN '80-84'
            ELSE '<80'
        END AS score_bucket,
        COUNT(*) AS n,
        COUNT(*) FILTER (WHERE UPPER(outcome)='WIN') AS wins,
        ROUND(COUNT(*) FILTER (WHERE UPPER(outcome)='WIN')::numeric/NULLIF(COUNT(*),0)*100,1) AS win_rate,
        ROUND(AVG(COALESCE(pnl_r,result_r,0))::numeric,3) AS avg_r,
        ROUND(AVG(COALESCE(pnl_eur,0))::numeric,4) AS avg_pnl_eur
    FROM public.experience_trades
    WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
      AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
      AND COALESCE(exit_time,updated_at) >= NOW() - INTERVAL '1 day' * %s
      AND COALESCE(score,0) > 0
    GROUP BY 1 ORDER BY score_bucket DESC
    """, (days,))

    # Bereken of score positief correleert met win rate
    buckets = {safe_str(r.get("score_bucket")): safe_float(r.get("win_rate")) for r in rows}
    correct_richting = 0
    pairs = [("95+","90-94"),("90-94","85-89"),("85-89","80-84")]
    for hoog, laag in pairs:
        if hoog in buckets and laag in buckets:
            if buckets[hoog] >= buckets[laag]:
                correct_richting += 1

    correlatie_gezond = correct_richting >= 2
    sla_geheugen_op(conn, "score_correlatie", f"analyse_{days}d",
                    {"buckets": buckets, "gezond": correlatie_gezond})

    return {
        "buckets": rows,
        "correlatie_gezond": correlatie_gezond,
        "correct_richting": correct_richting,
    }


def format_score_correlatie_rapport(data: Dict) -> str:
    if not data or not data.get("buckets"):
        return ""
    gezond = data.get("correlatie_gezond", True)
    r = "📊 SCORE → UITKOMST CORRELATIE:\n"
    for row in data["buckets"]:
        bucket = safe_str(row.get("score_bucket"))
        wr     = safe_float(row.get("win_rate"))
        n      = safe_int(row.get("n"))
        avg_r  = safe_float(row.get("avg_r"))
        r += f"• Score {bucket}: {wr:.1f}% WR | {n} trades | {avg_r:+.2f}R\n"
    status = "✅ Score correleert correct met win rate" if gezond else "⚠️ Score correleert NIET met win rate — scoremodel herbekijken"
    r += f"→ {status}\n\n"
    return r


