# FEATURE 12: WEEK-OVER-WEEK VERGELIJKING
# ============================================================
def vergelijk_periodes(conn) -> Dict:
    """
    Vergelijkt performance van afgelopen 7 dagen met de 7 dagen daarvoor.
    Detecteert verbetering of verslechtering.
    """
    rows = run_query(conn, """
    SELECT
        CASE
            WHEN COALESCE(exit_time,updated_at) >= NOW() - INTERVAL '7 days' THEN 'deze_week'
            ELSE 'vorige_week'
        END AS periode,
        COUNT(*) AS n,
        COUNT(*) FILTER (WHERE UPPER(outcome)='WIN') AS wins,
        ROUND(COUNT(*) FILTER (WHERE UPPER(outcome)='WIN')::numeric/NULLIF(COUNT(*),0)*100,1) AS win_rate,
        ROUND(SUM(CASE WHEN UPPER(outcome)='WIN'  THEN  ABS(COALESCE(pnl_eur,0))
                       WHEN UPPER(outcome)='LOSS' THEN -ABS(COALESCE(pnl_eur,0)) ELSE 0 END)::numeric,4) AS pnl,
        ROUND(COALESCE(SUM(CASE WHEN UPPER(outcome)='WIN' THEN ABS(COALESCE(pnl_eur,0)) ELSE 0 END),0)
            /NULLIF(SUM(CASE WHEN UPPER(outcome)='LOSS' THEN ABS(COALESCE(pnl_eur,0)) ELSE 0 END),0.001),2) AS profit_factor
    FROM public.experience_trades
    WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
      AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
      AND COALESCE(exit_time,updated_at) >= NOW() - INTERVAL '14 days'
    GROUP BY 1
    """)

    data: Dict[str, Dict] = {}
    for r in rows:
        periode = safe_str(r.get("periode"))
        data[periode] = {
            "n": safe_int(r.get("n")),
            "wins": safe_int(r.get("wins")),
            "win_rate": safe_float(r.get("win_rate")),
            "pnl": safe_float(r.get("pnl")),
            "profit_factor": safe_float(r.get("profit_factor")),
        }

    huidig = data.get("deze_week", {})
    vorig  = data.get("vorige_week", {})

    wr_diff = huidig.get("win_rate", 0) - vorig.get("win_rate", 0)
    pf_diff = huidig.get("profit_factor", 0) - vorig.get("profit_factor", 0)
    trend   = "verbeterend" if wr_diff > 3 else "verslechterend" if wr_diff < -3 else "stabiel"

    return {"huidig": huidig, "vorig": vorig,
            "wr_diff": round(wr_diff, 1), "pf_diff": round(pf_diff, 2),
            "trend": trend}


def format_week_vergelijking(data: Dict) -> str:
    if not data or not data.get("huidig"):
        return ""
    h = data["huidig"]
    v = data["vorig"]
    d = data.get("wr_diff", 0)
    trend_emoji = "📈" if data.get("trend") == "verbeterend" else "📉" if data.get("trend") == "verslechterend" else "➡️"
    return (
        f"📅 WEEK VERGELIJKING:\n"
        f"• Deze week:   {h.get('win_rate',0):.1f}% WR | {h.get('n',0)} trades | PnL: €{h.get('pnl',0):.4f}\n"
        f"• Vorige week: {v.get('win_rate',0):.1f}% WR | {v.get('n',0)} trades | PnL: €{v.get('pnl',0):.4f}\n"
        f"• Verschil: {d:+.1f}% WR {trend_emoji} {data.get('trend','')}\n\n"
    )


