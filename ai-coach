    """Huidige drawdown op basis van recente trades."""
    rows = run_query(conn, """
    SELECT COALESCE(pnl_r,result_r,0) AS pnl_r
    FROM public.experience_trades
    WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
      AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
    ORDER BY COALESCE(exit_time,updated_at) DESC LIMIT 50
    """)
    if not rows:
        return {"max_dd": 0.0, "huidige_dd": 0.0, "is_drawdown": False, "cum_r": 0.0}

    pnl_list = [safe_float(r.get("pnl_r")) for r in reversed(rows)]
    cum = peak = max_dd = 0.0
    for p in pnl_list:
        cum += p
        if cum > peak:
            peak = cum
        dd = peak - cum
        if dd > max_dd:
            max_dd = dd

    huidige_dd = peak - cum
    return {
        "max_dd": round(max_dd, 2),
        "huidige_dd": round(huidige_dd, 2),
        "is_drawdown": huidige_dd > DRAWDOWN_REDUCE_THRESHOLD,
        "cum_r": round(cum, 2),
    }


