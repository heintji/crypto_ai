                    f"{safe_float(r.get('win_rate')):.0f}% WR | "
                    f"+€{safe_float(r.get('total_pnl')):.4f} | "
                    f"{safe_int(r.get('n'))} trades\n"
                )

        if top5_slecht:
            rapport += "❌ Slechtste coins:\n"
            for r in top5_slecht:
                rapport += (
                    f"  • {safe_str(r.get('coin'))}: "
                    f"{safe_float(r.get('win_rate')):.0f}% WR | "
                    f"€{safe_float(r.get('total_pnl')):.4f} | "
                    f"{safe_int(r.get('n'))} trades\n"
                )

        if coin_analyse["blacklist"]:
            rapport += "⚫ Toevoegen aan blacklist:\n"
            for c in coin_analyse["blacklist"]:
                rapport += f"  • {c}\n"

        if coin_analyse["zorgwekkend"]:
            rapport += "⚠️ Zorgwekkend (nog niet blacklist):\n"
            for c in coin_analyse["zorgwekkend"]:
                rapport += f"  • {c}\n"

        rapport += "\n"

    # ── SECTIE: REGIME CORRELATIE ─────────────────────────────
    if regime_data:
        rapport += "📊 WIN RATE PER REGIME:\n"
        for r in regime_data:
            regime_n  = safe_str(r.get("regime"), "?").upper()
            r_wr      = safe_float(r.get("win_rate"))
            r_n       = safe_int(r.get("n"))
            r_r       = safe_float(r.get("avg_r"))
            emoji = {"BULL":"🟢","BEAR":"🔴","RANGE":"🟡"}.get(regime_n, "⚪")
            rapport += f"• {emoji} {regime_n}: {r_wr:.1f}% WR | {r_n} trades | {r_r:+.2f}R\n"
        rapport += "\n"

    # ── SECTIE: EDGE DECAY ────────────────────────────────────
    rapport += "⚡ EDGE DECAY CHECK:\n"
    rapport += f"• Simulatie WR: {sim_wr:.1f}% ({safe_int(edge_decay.get('SIM_n'))} trades)\n"
    rapport += f"• Live WR:      {live_wr:.1f}% ({safe_int(edge_decay.get('LIVE_n'))} trades)\n"
    rapport += f"• Verschil:     {ed_diff:.1f}%\n"

    if ed_diff > EDGE_DECAY_DREMPEL:
        rapport += f"⚠️ Edge decay gedetecteerd (grens: {EDGE_DECAY_DREMPEL:.0f}%)\n\n"
    elif ed_diff > 5:
        rapport += f"⚠️ Lichte edge decay — houd in de gaten\n\n"
    else:
        rapport += f"✅ Geen significante edge decay\n\n"

    # ── SECTIE: PROFIT FACTOR TREND ───────────────────────────
    rapport += "📈 PROFIT FACTOR TREND (8 weken):\n"
    rapport += f"• Trend: {pf_trend.get('trend', 'onbekend')}\n"
    rapport += f"• Eerste helft: {pf_trend.get('eerste_helft', 0):.2f} → Tweede helft: {pf_trend.get('tweede_helft', 0):.2f}\n"
    rapport += f"• Laatste 3 weken: {pf_trend.get('laatste_3w', 0):.2f}\n"
    if pf_trend.get("alle_waarden"):
        rapport += f"• Weekwaarden: {' | '.join(str(v) for v in pf_trend['alle_waarden'])}\n"
    rapport += f"• Advies: {pf_trend.get('actie', '-')}\n\n"

    # ── SECTIE: CONCRETE AANPASSINGEN ─────────────────────────
    aanpassingen: List[str] = []

    # Score drempel
    if score_advies["verschil"] > 0:
        aanpassingen.append(
            f"🎯 Verhoog MIN_SCORE_TO_TRADE: {score_advies['huidig']} → {score_advies['aanbeveling']}"
        )
    elif score_advies["verschil"] < 0:
        aanpassingen.append(
            f"🎯 Verlaag MIN_SCORE_TO_TRADE: {score_advies['huidig']} → {score_advies['aanbeveling']}"
        )

    # Stop loss
    if stop_advies["actie"] == "VERHOOG":
        aanpassingen.append(
            f"🛑 Verhoog ATR_MULTIPLIER: {stop_advies['huidig']:.1f} → {stop_advies['aanbeveling']:.1f}"
        )
    elif stop_advies["actie"] == "VERLAAG":
        aanpassingen.append(
            f"🛑 Verlaag ATR_MULTIPLIER: {stop_advies['huidig']:.1f} → {stop_advies['aanbeveling']:.1f}"
        )

    # Trading uren
    if uur_advies["aanbeveling_start"] != TRADING_HOURS_START:
        aanpassingen.append(
            f"📅 Trading uren: {TRADING_HOURS_START}:00 → {uur_advies['aanbeveling_start']}:00 start"
        )
    if uur_advies["aanbeveling_end"] != TRADING_HOURS_END:
        aanpassingen.append(
            f"📅 Trading uren: {TRADING_HOURS_END}:00 → {uur_advies['aanbeveling_end']}:00 einde"
        )

    # Setups stoppen
    for r in setup_data:
        s_setup = safe_str(r.get("setup"))
        s_wr    = safe_float(r.get("win_rate"))
        s_n     = safe_int(r.get("n"))
        if s_wr < 40 and s_n >= MIN_TRADES_FOR_ANALYSE:
            aanpassingen.append(f"⚡ Stop setup '{s_setup}' tijdelijk ({s_wr:.0f}% WR)")

    # Coins blacklist
    for c in coin_analyse["blacklist"][:3]:
        aanpassingen.append(f"⚫ Blacklist: {c.split('(')[0].strip()}")

    # Edge decay
    if ed_diff > EDGE_DECAY_DREMPEL:
        aanpassingen.append(f"⚡ Edge decay: Verhoog score drempel met 2-3 punten extra")

    if aanpassingen:
        rapport += f"{'─' * 34}\n"
        rapport += f"📋 CONCRETE AANPASSINGEN ({len(aanpassingen)}):\n"
        for i, aanpassing in enumerate(aanpassingen, 1):
            rapport += f"{i}. {aanpassing}\n"
        rapport += "\n"
    else:
        rapport += f"{'─' * 34}\n"
        rapport += "📋 Geen urgente aanpassingen nodig.\n"
        rapport += "   Systeem presteert binnen acceptabele grenzen.\n\n"

    # ── SECTIE: CLAUDE FINALE ─────────────────────────────────
    log("Claude finale beoordeling genereren...")
    claude_tekst = claude_finale_beoordeling(
        totalen, setup_data, score_advies, stop_advies,
        uur_advies, coin_analyse, edge_decay, pf_trend,
        aanpassingen, dagen,
    )

    if claude_tekst:
        rapport += f"{'─' * 34}\n"
        rapport += f"🧠 CLAUDE FINALE BEOORDELING:\n"
        rapport += f"{claude_tekst}\n\n"

    rapport += f"{'─' * 34}\n"
    rapport += f"🤖 BOT LOOPT GEWOON DOOR\n"
    rapport += f"Aanpassingen doe je via Render ENV vars.\n"
    rapport += f"Stuur STOP als je wil pauzeren.\n\n"
    rapport += f"Commands: STATUS | STOP | HEALTH | TRADES"

    return rapport, aanpassingen


def sla_rapport_op(conn, rapport: str, aanpassingen: List[str]) -> None:
    """
    Slaat het rapport en aanpassingen op in bot_state.
    Zodat de gebruiker het later nog kan opvragen via WhatsApp.
    """
    try:
        set_bot_state(conn, "laatste_coach_rapport", rapport[:2000])
        set_bot_state(conn, "laatste_coach_datum", now_utc().isoformat())
        set_bot_state(conn, "laatste_coach_aanpassingen",
                      json.dumps(aanpassingen[:10], ensure_ascii=False))
        log("✅ Rapport opgeslagen in bot_state")
    except Exception as e:
        log(f"⚠️ Rapport opslaan fout: {e}")


# ============================================================
# HOOFD FUNCTIE — aangeroepen door Cron en ANALYSE command
# ============================================================
def run_coach(dagen: int = 60, stuur_whatsapp: bool = True) -> str:
    """
    Voert de volledige AI Coach analyse uit.

    Parameters:
    - dagen:          Hoeveel dagen terug analyseren (default: 60)
    - stuur_whatsapp: Of het rapport via WhatsApp verstuurd moet worden

    Geeft het volledige rapport als string terug.
    Wordt aangeroepen door:
    - __main__ (Render Cron job)
    - whatsapp_webhook.py ANALYSE command
    """
    log("=" * 60)
    log(f"AI Coach v1.0 — Analyse gestart ({dagen} dagen)")
    log("=" * 60)
    log(f"Database:   {'✅' if DATABASE_URL else '❌ ONTBREEKT'}")
    log(f"Claude API: {'✅' if ANTHROPIC_API_KEY else '⚠️ niet ingesteld'}")
    log(f"Twilio:     {'✅' if TWILIO_ACCOUNT_SID else '⚠️ niet ingesteld'}")
    log("=" * 60)

    if not DATABASE_URL:
        fout = "❌ DATABASE_URL ontbreekt — coach kan niet draaien"
        log(fout)
        return fout

    try:
        conn = db_connect()
        log("✅ Database verbonden")

        # Hoeveel trades zijn er?
        n_trades = run_scalar(conn, """
        SELECT COUNT(*) FROM public.experience_trades
        WHERE UPPER(COALESCE(source,'')) IN ('REAL','LIVE')
          AND UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
          AND COALESCE(exit_time, updated_at) >= NOW() - INTERVAL '1 day' * %s
        """, (dagen,), 0)

        log(f"📊 {n_trades} trades gevonden voor analyse")

        if safe_int(n_trades) < MIN_TRADES_FOR_ANALYSE:
            bericht = (
                f"🧠 AI COACH RAPPORT\n"
                f"{'─' * 28}\n\n"
                f"Te weinig trades voor analyse.\n"
                f"Gevonden: {n_trades} trades\n"
                f"Minimum: {MIN_TRADES_FOR_ANALYSE} trades\n\n"
                f"Kom over 2 weken terug als er\n"
                f"meer live trades zijn gedaan.\n\n"
                f"Commands: STATUS | HEALTH"
            )
            if stuur_whatsapp:
                send_whatsapp(bericht)
            conn.close()
            return bericht

        # Volledige analyse
        log("Analyse wordt uitgevoerd...")
        rapport, aanpassingen = bouw_rapport(conn, dagen)

        # Opslaan in DB
        sla_rapport_op(conn, rapport, aanpassingen)

        log(f"✅ Rapport klaar: {len(rapport)} tekens | {len(aanpassingen)} aanpassingen")

        # Versturen via WhatsApp
        if stuur_whatsapp:
            success = send_whatsapp(rapport)
            if success:
                log("✅ Rapport verzonden via WhatsApp")
            else:
                log("❌ WhatsApp verzending mislukt")

        conn.close()
        return rapport

    except Exception as e:
        fout = f"❌ AI Coach fout: {type(e).__name__}: {e}"
        log(fout)
        if stuur_whatsapp and TWILIO_ACCOUNT_SID:
            send_whatsapp(
                f"🚨 AI COACH FOUT\n\n"
                f"Fout: {type(e).__name__}\n"
                f"{str(e)[:150]}\n\n"
                f"Coach rapport kon niet worden gegenereerd.\n"
                f"Check Render logs voor details."
            )
        return fout


# ============================================================
# MAIN — Render Cron entry point
# ============================================================
if __name__ == "__main__":
    import argparse

    parser = argparse.ArgumentParser(description="AI Coach — Crypto Bot Analyse")
    parser.add_argument(
        "--dagen",
        type=int,
        default=60,
        help="Aantal dagen terug voor analyse (default: 60)",
    )
    parser.add_argument(
        "--no-whatsapp",
        action="store_true",
        help="Sla WhatsApp verzending over (alleen naar logs)",
    )
    args = parser.parse_args()

    rapport = run_coach(
        dagen=args.dagen,
        stuur_whatsapp=not args.no_whatsapp,
    )

    # Altijd naar stdout voor Render logs
    print("\n" + "=" * 60)
    print("COACH RAPPORT (volledig):")
    print("=" * 60)
    print(rapport)
