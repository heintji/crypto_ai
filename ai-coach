    return {"beschikbaar": False}


def analyseer_open_posities_gezondheid(live_state: Dict,
                                        shadow_state: Dict,
                                        prijzen: Dict) -> Dict:
    """
    Analyseert de gezondheid van alle open posities.
    Berekent floating P&L, hoelang open, risico.
    """
    problemen = []
    floating_pnl = 0.0
    posities_detail = []

    for symbol, pos in live_state.get("posities", {}).items():
        entry    = safe_float(pos.get("entry"))
        stop     = safe_float(pos.get("stop_loss") or pos.get("stop"))
        qty      = safe_float(pos.get("qty"))
        opened   = safe_float(pos.get("opened_at"))
        market   = safe_str(pos.get("market", f"{symbol[:-4]}-EUR"))

        # Huidige prijs
        current = prijzen.get(market, 0.0)

        if current > 0 and entry > 0 and qty > 0:
            pnl = (current - entry) * qty
            floating_pnl += pnl

            # Check te lang open
            if opened > 0:
                uren_open = (_time.time() - opened) / 3600
                if uren_open > 20:
                    problemen.append(f"{symbol}: {uren_open:.1f}u open — bijna max houdtijd")

            # Check onder stop loss
            if stop > 0 and current < stop:
                problemen.append(f"{symbol}: prijs {current:.6f} ONDER stop {stop:.6f}!")

            posities_detail.append({
                "symbol": symbol,
                "entry": entry,
                "current": current,
                "pnl": round(pnl, 4),
                "market": market,
            })

    return {
        "floating_pnl": round(floating_pnl, 4),
        "n_live": live_state.get("n_posities", 0),
        "n_shadow": shadow_state.get("n_posities", 0),
        "problemen": problemen,
        "posities_detail": posities_detail,
    }


def format_open_posities_rapport(data: Dict) -> str:
    if not data:
        return ""
    r = (
        f"📂 OPEN POSITIES:\n"
        f"• Live open:    {data.get('n_live',0)}\n"
        f"• Shadow open:  {data.get('n_shadow',0)}\n"
        f"• Floating PnL: €{data.get('floating_pnl',0):+.4f}\n"
    )
    for pos in data.get("posities_detail", [])[:3]:
        pnl = safe_float(pos.get("pnl"))
        emoji = "📈" if pnl >= 0 else "📉"
        r += f"  {emoji} {pos['symbol']}: entry={pos['entry']:.6f} | nu={pos['current']:.6f} | PnL=€{pnl:+.4f}\n"
    if data.get("problemen"):
        r += "⚠️ PROBLEMEN:\n"
        for p in data["problemen"]:
            r += f"  → {p}\n"
    r += "\n"
    return r


def format_database_overzicht(overzicht: Dict) -> str:
    if not overzicht:
        return ""
    r = "🗄️ DATABASE STATUS:\n"
    for tabel, info in overzicht.items():
        n      = safe_int(info.get("n"))
        bestaat = info.get("bestaat", False)
        status  = f"{n:,} rijen" if bestaat else "❌ ontbreekt"
        r += f"• {tabel}: {status}\n"
    r += "\n"
    return r


def format_bot_configuratie_rapport(data: Dict) -> str:
    if not data:
