BITVAVO_API_KEY    = (os.getenv("BITVAVO_API_KEY") or "").strip()
BITVAVO_API_SECRET = (os.getenv("BITVAVO_API_SECRET") or "").strip()
BITVAVO_BASE       = "https://api.bitvavo.com"

import hashlib
import hmac
import time as _time


def _bitvavo_headers(method: str, path: str, body: str = "") -> Dict:
    """Bitvavo API headers met correcte HMAC signing."""
    if not BITVAVO_API_KEY or not BITVAVO_API_SECRET:
        return {}
    ts  = str(int(_time.time() * 1000))
    msg = f"{ts}{method}/v2{path}{body}"
    sig = hmac.new(
        BITVAVO_API_SECRET.encode("utf-8"),
        msg.encode("utf-8"),
        digestmod=hashlib.sha256,
    ).hexdigest()
    return {
        "Bitvavo-Access-Key":       BITVAVO_API_KEY,
        "Bitvavo-Access-Signature": sig,
        "Bitvavo-Access-Timestamp": ts,
        "Bitvavo-Access-Window":    "10000",
        "Content-Type":             "application/json",
    }


def _bitvavo_get(path: str) -> Optional[Any]:
    """Haalt data op van Bitvavo API."""
    try:
        headers = _bitvavo_headers("GET", path)
        if not headers:
            return None
        resp = requests.get(f"{BITVAVO_BASE}/v2{path}", headers=headers, timeout=10)
        if resp.ok:
            return resp.json()
        log(f"⚠️ Bitvavo {path}: {resp.status_code}")
        return None
    except Exception as e:
        log(f"⚠️ Bitvavo fout: {e}")
        return None


def get_bitvavo_balances() -> Dict[str, float]:
    """Haalt alle Bitvavo balances op."""
    data = _bitvavo_get("/balance")
    if not data or not isinstance(data, list):
        return {}
    balances = {}
    for item in data:
        symbol    = safe_str(item.get("symbol"))
        available = safe_float(item.get("available"))
        inOrder   = safe_float(item.get("inOrder"))
        total     = available + inOrder
        if total > 0:
            balances[symbol] = total
    return balances


def get_bitvavo_open_orders() -> List[Dict]:
    """Haalt alle open orders op van Bitvavo."""
    data = _bitvavo_get("/ordersOpen")
    return data if isinstance(data, list) else []


def get_bitvavo_recent_trades(market: str = "", limit: int = 10) -> List[Dict]:
    """Haalt recente trades op van Bitvavo."""
    path = f"/trades?limit={limit}"
    if market:
        path = f"/trades?market={market}&limit={limit}"
    data = _bitvavo_get(path)
    return data if isinstance(data, list) else []


def get_bitvavo_ticker_prices() -> Dict[str, float]:
    """Haalt alle huidige prijzen op van Bitvavo (publiek endpoint)."""
    try:
        resp = requests.get(f"{BITVAVO_BASE}/v2/ticker/price", timeout=10)
        if resp.ok:
            return {r["market"]: safe_float(r.get("price")) for r in resp.json()
                    if r.get("market") and r.get("price")}
    except Exception:
        pass
    return {}


def get_bitvavo_portfolio_waarde(balances: Dict[str, float],
                                  prijzen: Dict[str, float]) -> Dict:
    """Berekent totale portfolio waarde in EUR."""
    totaal_eur = 0.0
    assets = []
    for symbol, hoeveelheid in balances.items():
        if symbol == "EUR":
            eur_waarde = hoeveelheid
        else:
            prijs = prijzen.get(f"{symbol}-EUR", 0.0)
            eur_waarde = hoeveelheid * prijs
        if eur_waarde > 0.001:
            assets.append({
                "symbol": symbol,
                "hoeveelheid": hoeveelheid,
                "eur_waarde": round(eur_waarde, 4),
            })
            totaal_eur += eur_waarde

    assets.sort(key=lambda x: x["eur_waarde"], reverse=True)
    return {
        "totaal_eur": round(totaal_eur, 4),
        "eur_cash":   round(balances.get("EUR", 0.0), 4),
        "assets":     assets,
        "n_assets":   len(assets),
    }


def analyseer_bitvavo_account(conn) -> Dict:
    """
    Volledige Bitvavo account analyse.
    Bekijkt balances, open orders, recente trades en portfolio waarde.
    Vergelijkt met wat de bot verwacht te hebben.
    """
    if not BITVAVO_API_KEY:
        return {"beschikbaar": False, "reden": "BITVAVO_API_KEY niet ingesteld"}

    log("📊 Bitvavo account ophalen...")
    balances    = get_bitvavo_balances()
    open_orders = get_bitvavo_open_orders()
    prijzen     = get_bitvavo_ticker_prices()
    portfolio   = get_bitvavo_portfolio_waarde(balances, prijzen)

    # Vergelijk met bot state
    try:
        live_state_path = os.path.join(
            os.getenv("DATA_DIR") or ("/data" if os.path.isdir("/data") else "/tmp/data"),
            "live_state.json"
        )
        bot_posities = {}
        if os.path.exists(live_state_path):
            with open(live_state_path) as f:
                state = json.load(f)
            bot_posities = state.get("positions", {})
    except Exception:
        bot_posities = {}

    # Detecteer discrepanties
    discrepanties = []
    for symbol, pos in bot_posities.items():
        base = symbol[:-4] if symbol.endswith("USDT") else symbol
        bitvavo_hoeveelheid = balances.get(base, 0.0)
        bot_qty = safe_float(pos.get("qty"))
        if bitvavo_hoeveelheid > 0 and bot_qty > 0:
            verschil_pct = abs(bitvavo_hoeveelheid - bot_qty) / max(bot_qty, 0.0001) * 100
            if verschil_pct > 5:
                discrepanties.append(
                    f"{base}: bot verwacht {bot_qty:.6f} maar Bitvavo heeft {bitvavo_hoeveelheid:.6f} ({verschil_pct:.1f}% verschil)"
                )

    resultaat = {
        "beschikbaar":    True,
        "portfolio":      portfolio,
        "open_orders":    len(open_orders),
        "open_orders_detail": open_orders[:3],
        "bot_posities":   len(bot_posities),
        "discrepanties":  discrepanties,
        "balances":       balances,
    }

    # Sla op in geheugen
    sla_geheugen_op(conn, "bitvavo", "account_snapshot", {
        "ts": now_utc().isoformat(),
        "totaal_eur": portfolio["totaal_eur"],
        "n_assets": portfolio["n_assets"],
        "open_orders": len(open_orders),
    })

    if discrepanties:
        stuur_alert(
            "BITVAVO DISCREPANTIE",
            f"{len(discrepanties)} verschil(len) gevonden tussen bot state en Bitvavo",
            "Check open posities via TRADES command"
        )

    log(f"✅ Bitvavo: €{portfolio['totaal_eur']:.2f} portfolio | {len(open_orders)} open orders")
    return resultaat


