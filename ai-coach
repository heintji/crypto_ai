def get_edge_decay(conn, days: int) -> Dict:
    rows = run_query(conn, """
    SELECT CASE WHEN UPPER(COALESCE(source,'')) IN ('REAL','LIVE') THEN 'LIVE'
                WHEN UPPER(COALESCE(source,'')) = 'SIM' THEN 'SIM'
                WHEN UPPER(COALESCE(source,'')) = 'SHADOW' THEN 'SHADOW'
                ELSE 'OTHER' END AS bron,
        COUNT(*) AS n,
        ROUND(COUNT(*) FILTER (WHERE UPPER(outcome)='WIN')::numeric/NULLIF(COUNT(*),0)*100,1) AS win_rate
    FROM public.experience_trades
    WHERE UPPER(COALESCE(outcome,'')) IN ('WIN','LOSS')
      AND COALESCE(exit_time,updated_at) >= NOW() - INTERVAL '1 day' * %s
    GROUP BY 1
    """, (days,))
    data = {}
    for r in rows:
        b = safe_str(r.get("bron"))
        data[f"{b}_wr"] = safe_float(r.get("win_rate"))
        data[f"{b}_n"]  = safe_float(r.get("n"))
    return data


